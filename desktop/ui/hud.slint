import { Button, ScrollView, ListView, LineEdit } from "std-widgets.slint";
import { HistoryItem, LanguageItem, ApiKeyItem } from "components/types.slint";
import { KeyPoolManager } from "components/key_pool_manager.slint";
import { StatChip } from "components/stat_chip.slint";
import { SectionHeader } from "components/section_header.slint";
import { TabBar } from "components/tab_bar.slint";
import { ProviderCard } from "components/provider_card.slint";
import { ModelRow } from "components/model_row.slint";
import { KeyField } from "components/key_field.slint";
import { HistoryCard } from "components/history_card.slint";
import { InfoTooltip } from "components/info_tooltip.slint";
import { Theme } from "components/theme.slint";

import "./fonts/Inter-Regular.ttf";
import "./fonts/Inter-Medium.ttf";
import "./fonts/Inter-SemiBold.ttf";
import "./fonts/Inter-Bold.ttf";

component VoicePill inherits Rectangle {
    in-out property <int> active-state: 0;
    in-out property <int> opt-idle: 0;
    in-out property <int> opt-listening: 0;
    in-out property <int> opt-transcribe: 0;
    in-out property <int> opt-success: 0;
    in-out property <int> opt-error: 0;

    pure function current-opt() -> int {
        if (root.active-state == 0) { return root.opt-idle; }
        if (root.active-state == 1) { return root.opt-listening; }
        if (root.active-state == 2) { return root.opt-transcribe; }
        if (root.active-state == 3) { return root.opt-success; }
        return root.opt-error;
    }
    in-out property <float> surface-opacity: 0.85;
    in-out property <float> anim-tick: 0.0;
    in-out property <int> timer-sec: 0;
    in-out property <string> timer-text: "0:00";
    in-out property <float> bar1-h: 3.0;
    in-out property <float> bar2-h: 3.0;
    in-out property <float> bar3-h: 3.0;
    in-out property <float> bar4-h: 3.0;
    in-out property <float> bar5-h: 3.0;

    callback clicked();
    callback right-clicked();
    callback drag-window(length, length);
    callback drag-finished();

    pure function pill-width() -> length {
        let opt = root.current-opt();
        if (root.active-state == 0) {
            return opt == 1 ? 44px : (opt == 2 ? 56px : 48px);
        }
        if (root.active-state == 1) {
            return opt == 1 ? 84px : (opt == 2 ? 100px : 112px);
        }
        if (root.active-state == 2) {
            return opt == 1 ? 76px : (opt == 2 ? 80px : 72px);
        }
        if (root.active-state == 3) {
            return opt == 1 ? 64px : (opt == 2 ? 68px : 60px);
        }
        return opt == 2 ? 64px : 60px;
    }

    width: root.pill-width();
    height: 44px;
    border-radius: Theme.radius-pill;
    background: Theme.vignette.with-alpha(root.surface-opacity);
    border-width: 1px;
    border-color: Theme.line.with-alpha(0.65);
    clip: true;

    animate width { duration: 240ms; easing: ease-out; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        property <length> start-x;
        property <length> start-y;
        property <bool> is-dragging: false;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                start-x = self.mouse-x;
                start-y = self.mouse-y;
                is-dragging = false;
            }
            if (event.kind == PointerEventKind.up) {
                if (!is-dragging) {
                    if (event.button == PointerEventButton.right) {
                        root.right-clicked();
                    } else if (event.button == PointerEventButton.left) {
                        root.clicked();
                    }
                } else {
                    root.drag-finished();
                }
                is-dragging = false;
            }
        }

        moved => {
            if (self.pressed) {
                let dx = self.mouse-x - start-x;
                let dy = self.mouse-y - start-y;
                if (abs(dx) > 3px || abs(dy) > 3px) {
                    is-dragging = true;
                    root.drag-window(dx, dy);
                }
            }
        }
    }

    // ==================== IDLE OPTIONS ====================\
    if root.active-state == 0 : Rectangle {
        // Option A: Micro Mic (48px capsule, 20px mic mathematically centered)
        if root.current-opt() == 0 : Image {
            source: @image-url("../assets/icons/mic.svg");
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }

        // Option B: Standby LED (Single steady Breathing Pip)
        if root.current-opt() == 1 : Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.ink-muted;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: 0.3 + 0.7 * abs(sin(root.anim-tick * 3.5deg));
        }

        // Option C: Pill Edge Accent
        if root.current-opt() == 2 : HorizontalLayout {
            spacing: Theme.space-8;
            alignment: center;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 20px;

            Rectangle {
                width: 3px;
                height: 14px;
                border-radius: 1.5px;
                background: Theme.accent;
                opacity: 0.4 + 0.6 * abs(sin(root.anim-tick * 4.0deg));
                y: 3px;
            }

            Image {
                source: @image-url("../assets/icons/mic.svg");
                width: 18px;
                height: 18px;
                y: 1px;
                image-fit: contain;
            }
        }
    }

    // ==================== LISTENING OPTIONS ====================\
    if root.active-state == 1 : Rectangle {
        // Option A: Trio Equalizer + Live Timer (110px Pill)
        if root.current-opt() == 0 : listen-row-a := HorizontalLayout {
            spacing: Theme.space-8;
            alignment: center;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 20px;

            // Pulsing Recording Dot
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.danger;
                opacity: 0.25 + 0.75 * abs(sin(root.anim-tick * 5.5deg));
                y: 7px;
            }

            // 3 Equalizer bars: Center-peaked formant arch (Left: Pitch, Center: Core Vowel Formant, Right: Consonants)
            Rectangle {
                width: 14px;
                height: 20px;

                // Left: Vocal pitch & chest depth
                Rectangle {
                    width: 2.5px;
                    height: root.bar1-h * 1px;
                    border-radius: 1.25px;
                    background: Theme.white;
                    x: 0px;
                    y: 10px - (root.bar1-h * 0.5px);
                    animate height, y { duration: 60ms; easing: ease-out; }
                }
                // Center: Core vowel formant (tallest peak)
                Rectangle {
                    width: 2.5px;
                    height: root.bar3-h * 1px;
                    border-radius: 1.25px;
                    background: Theme.white;
                    x: 5px;
                    y: 10px - (root.bar3-h * 0.5px);
                    animate height, y { duration: 60ms; easing: ease-out; }
                }
                // Right: High consonant articulation
                Rectangle {
                    width: 2.5px;
                    height: root.bar2-h * 1px;
                    border-radius: 1.25px;
                    background: Theme.white;
                    x: 10px;
                    y: 10px - (root.bar2-h * 0.5px);
                    animate height, y { duration: 60ms; easing: ease-out; }
                }
            }

            pill-timer-a := Text {
                text: root.timer-text;
                font-size: Theme.type-label.size;
                font-weight: 500;
                color: Theme.ink-secondary;
                height: 20px;
                vertical-alignment: center;
            }
        }

        // Option B: Quintet 5-Bar Waveform (Centered Symmetrical Vocal Formant Arch)
        if root.current-opt() == 1 : Rectangle {
            width: 26px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            Rectangle { width: 2.5px; height: root.bar1-h * 1px; border-radius: 1.25px; background: Theme.white; x: 0px; y: 10px - (root.bar1-h * 0.5px); animate height, y { duration: 60ms; easing: ease-out; } }
            Rectangle { width: 2.5px; height: root.bar2-h * 1px; border-radius: 1.25px; background: Theme.white; x: 6px; y: 10px - (root.bar2-h * 0.5px); animate height, y { duration: 60ms; easing: ease-out; } }
            Rectangle { width: 2.5px; height: root.bar3-h * 1px; border-radius: 1.25px; background: Theme.white; x: 12px; y: 10px - (root.bar3-h * 0.5px); animate height, y { duration: 60ms; easing: ease-out; } }
            Rectangle { width: 2.5px; height: root.bar4-h * 1px; border-radius: 1.25px; background: Theme.white; x: 18px; y: 10px - (root.bar4-h * 0.5px); animate height, y { duration: 60ms; easing: ease-out; } }
            Rectangle { width: 2.5px; height: root.bar5-h * 1px; border-radius: 1.25px; background: Theme.white; x: 24px; y: 10px - (root.bar5-h * 0.5px); animate height, y { duration: 60ms; easing: ease-out; } }
        }

        // Option C: Expanding Red Radar Pulse + Timer
        if root.current-opt() == 2 : listen-row-c := HorizontalLayout {
            spacing: Theme.space-8;
            alignment: center;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 20px;

            Rectangle {
                width: 18px;
                height: 20px;

                // Radar pulse ripple ring
                Rectangle {
                    property <float> phase: (root.anim-tick * 3.2) - floor(root.anim-tick * 3.2 / 100.0) * 100.0;
                    property <float> progress: phase / 100.0;
                    width: 7px + progress * 11px;
                    height: 7px + progress * 11px;
                    border-radius: (7px + progress * 11px) / 2;
                    border-width: 1.5px;
                    border-color: Theme.danger;
                    opacity: 1.0 - progress;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                // Core red dot
                Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.danger;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            pill-timer-c := Text {
                text: root.timer-text;
                font-size: Theme.type-label.size;
                font-weight: 500;
                color: Theme.ink-secondary;
                height: 20px;
                vertical-alignment: center;
            }
        }
    }

    // ==================== TRANSCRIBING OPTIONS ====================\
    if root.active-state == 2 : Rectangle {
        // Option A: Hairline Orbital Spinner (Trailing Comet Arc)
        if root.current-opt() == 0 : Rectangle {
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            // Track background ring
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 1.5px;
                border-color: Theme.line;
                background: transparent;
                x: 1px;
                y: 1px;
            }

            // High-contrast rotating orbital pip
            Rectangle {
                property <angle> rot-ang: (root.anim-tick * 8.0) * 1deg;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent-soft;
                x: 9px + cos(rot-ang) * 9px;
                y: 9px + sin(rot-ang) * 9px;
            }
        }

        // Option B: Sine Wave Ripple (Triple Shifting Pillars)
        if root.current-opt() == 1 : HorizontalLayout {
            spacing: Theme.space-4;
            alignment: center;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 20px;

            Rectangle {
                property <float> phase: abs(sin((root.anim-tick * 6.0) * 1deg));
                width: 2.5px;
                height: 4px + phase * 10px;
                border-radius: 1.25px;
                background: Theme.accent-soft;
                y: 10px - (self.height * 0.5);
            }
            Rectangle {
                property <float> phase: abs(sin((root.anim-tick * 6.0 + 45.0) * 1deg));
                width: 2.5px;
                height: 4px + phase * 10px;
                border-radius: 1.25px;
                background: Theme.accent-soft;
                y: 10px - (self.height * 0.5);
            }
            Rectangle {
                property <float> phase: abs(sin((root.anim-tick * 6.0 + 90.0) * 1deg));
                width: 2.5px;
                height: 4px + phase * 10px;
                border-radius: 1.25px;
                background: Theme.accent-soft;
                y: 10px - (self.height * 0.5);
            }
        }

        // Option C: Radar Ping-Pong (Smooth Back-and-Forth Scan)
        if root.current-opt() == 2 : Rectangle {
            width: 32px;
            height: 10px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            // Track groove
            Rectangle {
                width: 32px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.line;
                y: 3.5px;
            }

            // Ping-pong runner pip
            Rectangle {
                property <float> t: (sin(root.anim-tick * 5.0deg) + 1.0) / 2.0;
                width: 8px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent-soft;
                x: t * 24px;
                y: 3px;
            }
        }
    }

    // ==================== SUCCESS OPTIONS ====================\
    if root.active-state == 3 : Rectangle {
        // Option A: Minimal Check (Centered 20px SVG)
        if root.current-opt() == 0 : Image {
            source: @image-url("../assets/icons/check.svg");
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }

        // Option B: Ring Check (Check enclosed in 22px Emerald Circle)
        if root.current-opt() == 1 : Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: Theme.success-deep.with-alpha(0.18);
            border-width: 1px;
            border-color: Theme.success-deep.with-alpha(0.6);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            Image {
                source: @image-url("../assets/icons/check.svg");
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
        }

        // Option C: Double Pip Confirmed
        if root.current-opt() == 2 : HorizontalLayout {
            spacing: Theme.space-4;
            alignment: center;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 20px;

            Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: Theme.success-deep; y: 7.5px; }
            Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: Theme.success-deep; y: 7.5px; }
        }
    }

    // ==================== ERROR OPTIONS ====================\
    if root.active-state == 4 : Rectangle {
        // Option A: Exclamation Alert (Subtle Alarm Pulse)
        if root.current-opt() == 0 : Image {
            source: @image-url("../assets/icons/alert.svg");
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            opacity: 0.6 + 0.4 * abs(sin(root.anim-tick * 8.0deg));
        }

        // Option B: Retry Pulse (Red Aura Halo)
        if root.current-opt() == 1 : Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: Theme.danger.with-alpha(0.2);
            border-width: 1px;
            border-color: Theme.danger.with-alpha(0.7);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            Image {
                source: @image-url("../assets/icons/alert.svg");
                width: 13px;
                height: 13px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
        }

        // Option C: Rapid Warning Indicator
        if root.current-opt() == 2 : HorizontalLayout {
            spacing: Theme.space-4;
            alignment: center;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 20px;

            Rectangle {
                width: 3px;
                height: 12px;
                border-radius: 1.5px;
                background: Theme.danger;
                y: 4px;
                opacity: 0.4 + 0.6 * abs(sin(root.anim-tick * 10.0deg));
            }
            Rectangle {
                width: 3px;
                height: 6px;
                border-radius: 1.5px;
                background: Theme.danger;
                y: 7px;
                opacity: 0.4 + 0.6 * abs(sin(root.anim-tick * 10.0deg));
            }
        }
    }
}

export component FloatingPillWindow inherits Window {
    always-on-top: true;
    no-frame: true;
    background: transparent;
    default-font-family: "Inter";
    icon: @image-url("../assets/icons/sotto-mark-dark.svg");
    width: 140px;
    height: 60px;

    in-out property <int> active-state <=> pill.active-state;
    in-out property <int> opt-idle <=> pill.opt-idle;
    in-out property <int> opt-listening <=> pill.opt-listening;
    in-out property <int> opt-transcribe <=> pill.opt-transcribe;
    in-out property <int> opt-success <=> pill.opt-success;
    in-out property <int> opt-error <=> pill.opt-error;
    in-out property <float> surface-opacity <=> pill.surface-opacity;
    in-out property <float> anim-tick <=> pill.anim-tick;
    in-out property <int> timer-sec <=> pill.timer-sec;
    in-out property <string> timer-text <=> pill.timer-text;
    in-out property <float> bar1-h <=> pill.bar1-h;
    in-out property <float> bar2-h <=> pill.bar2-h;
    in-out property <float> bar3-h <=> pill.bar3-h;
    in-out property <float> bar4-h <=> pill.bar4-h;
    in-out property <float> bar5-h <=> pill.bar5-h;

    callback cycle-state <=> pill.clicked;
    callback toggle-suite <=> pill.right-clicked;
    callback drag-window <=> pill.drag-window;
    callback drag-finished <=> pill.drag-finished;

    pill := VoicePill {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

export component StudioWindow inherits Window {
    title: "Sotto — Voice Pill Studio & Settings";
    icon: @image-url("../assets/icons/sotto-mark-dark.svg");
    min-width: 760px;
    min-height: 600px;
    preferred-width: 1040px;
    preferred-height: 840px;
    background: Theme.input-bg;
    default-font-family: "Inter";

    in-out property <bool> is-fullscreen: false;
    callback toggle-fullscreen();

    in-out property <int> active-tab: 0; // 0 = Dictations, 1 = Providers, 2 = Customization
    in-out property <[HistoryItem]> history-items: [];
    in-out property <[HistoryItem]> visible-history-items: [];
    in-out property <bool> history-virtualized: false;
    callback history-drag-scroll(float);
    in-out property <length> top-spacer-height: 0px;
    in-out property <length> bottom-spacer-height: 0px;
    in-out property <int> history-count: 0;
    in-out property <bool> purge-confirm-armed: false;
    in-out property <int> copied-item-id: -1;
    in-out property <bool> save-feedback: false;
    in-out property <length> history-viewport-y: 0px;
    in-out property <length> history-content-height: 2000px;
    in-out property <float> history-scroll-progress: 0.0;
    in-out property <bool> history-is-scrolling: false;
    in-out property <bool> history-can-scroll: false;
    out property <length> history-viewport-height: Math.max(100px, self.height - 156px);
    out property <length> providers-viewport-height: Math.max(100px, self.height - 100px);
    out property <length> custom-viewport-height: Math.max(100px, self.height - 100px);

    callback select-tab(int);
    callback copy-history-item(int, string);
    callback clear-all-history();
    callback save-customization();
    in-out property <string> trigger-primary-display: "F8";
    in-out property <string> trigger-secondary-display: "Ctrl + Shift + Space";
    in-out property <string> cancel-primary-display: "Esc";
    in-out property <string> cancel-secondary-display: "Not set";
    in-out property <bool> launch-on-startup: false;
    callback toggle-launch-on-startup();
    in-out property <string> trigger-status: "";
    in-out property <bool> mouse-hook-ready: false;
    callback poll-mouse-hook();
    in-out property <bool> is-recording-key: false;
    // Which slot is armed (0 primary, 1 secondary, -1 idle). Only the armed
    // row shows Cancel + accent; a single press records into one slot only.
    in-out property <int> recording-slot: -1;
    callback start-recording-key(int);
    callback stop-recording-key();
    callback reset-trigger(int);
    in-out property <int> trigger-mode: 0; // 0: Hands-Free Toggle, 1: Push to Talk
    in-out property <int> capture-mode: 1; // 0: Always-On, 1: Dual-Mic Splice, 2: Onboard Only
    callback set-capture-mode(int);
    in-out property <bool> chimes-enabled: true;
    in-out property <bool> media-pause-enabled: true;
    callback toggle-chimes();
    callback toggle-media-pause();
    in-out property <bool> is-changing-hotkey: false;
    in-out property <length> custom-viewport-y: 0px;
    in-out property <length> custom-content-height: custom_content_layout.preferred-height;
    in-out property <float> custom-scroll-progress: 0.0;
    in-out property <bool> custom-is-scrolling: false;
    in-out property <bool> custom-can-scroll: true;
    callback custom-drag-scroll(float);
    callback set-trigger-mode(int);

    // Providers tab state ("groq" | "gemini")
    in-out property <string> provider-id: "groq";
    in-out property <[ApiKeyItem]> groq-key-pool: [];
    in-out property <[ApiKeyItem]> gemini-key-pool: [];
    in-out property <string> groq-new-key: "";
    in-out property <string> gemini-new-key: "";
    callback add-provider-key(string, string);
    callback remove-provider-key(string, string);
    in-out property <string> provider-chip-text: "Groq whisper-large-v3-turbo";
    in-out property <string> groq-key: "";
    in-out property <string> gemini-key: "";
    in-out property <bool> groq-key-visible: false;
    in-out property <bool> gemini-key-visible: false;
    in-out property <[string]> groq-models: ["whisper-large-v3-turbo"];
    in-out property <[string]> gemini-models: ["gemini-3.5-transcribe"];
    in-out property <int> groq-model-index: 0;
    in-out property <int> gemini-model-index: 0;
    in-out property <string> provider-status: "";
    in-out property <bool> provider-status-ok: false;
    in-out property <bool> provider-testing: false;
    in-out property <bool> provider-save-feedback: false;
    callback select-provider(string);
    callback save-provider();
    callback test-provider();
    callback open-provider-site(string);
    callback toggle-key-visible(string);

    // Language selection state
    in-out property <string> transcription-language: "en";
    in-out property <bool> model-supports-multilingual: true;
    in-out property <bool> language-dropdown-open: false;
    in-out property <string> selected-other-language-display: "More Languages";
    in-out property <[LanguageItem]> other-languages-col1: [];
    in-out property <[LanguageItem]> other-languages-col2: [];
    callback select-language(string);
    callback toggle-language-dropdown();
    callback model-changed(string, int);
    // AI Post-Processing LLM state
    in-out property <bool> post-process-llm-enabled: false;
    in-out property <string> post-process-llm-provider: "groq";
    in-out property <string> post-process-llm-model: "qwen/qwen3.8-27b";
    in-out property <int> post-process-style: 0; // 0 = Minimal, 1 = Context-Aware
    callback toggle-post-process-llm();
    callback set-post-process-provider(string);
    callback set-post-process-model(string);
    callback set-post-process-style(int);

    // Tab 1 smooth scrolling
    in-out property <length> providers-viewport-y: 0px;
    in-out property <length> providers-content-height: providers_content_layout.preferred-height;
    in-out property <float> providers-scroll-progress: 0.0;
    in-out property <bool> providers-is-scrolling: false;
    in-out property <bool> providers-can-scroll: false;
    callback providers-drag-scroll(float);

    in-out property <int> active-state: 0;
    in-out property <int> opt-idle: 0;
    in-out property <int> opt-listening: 0;
    in-out property <int> opt-transcribe: 0;
    in-out property <int> opt-success: 0;
    in-out property <int> opt-error: 0;

    pure function active-option() -> int {
        if (root.active-state == 0) { return root.opt-idle; }
        if (root.active-state == 1) { return root.opt-listening; }
        if (root.active-state == 2) { return root.opt-transcribe; }
        if (root.active-state == 3) { return root.opt-success; }
        return root.opt-error;
    }
    in-out property <float> surface-opacity: 0.85;
    in-out property <int> bg-mode: 0;
    in-out property <float> anim-tick: 0.0;
    in-out property <int> timer-sec: 0;
    in-out property <string> timer-text: "0:00";
    in-out property <float> bar1-h: 3.0;
    in-out property <float> bar2-h: 3.0;
    in-out property <float> bar3-h: 3.0;
    in-out property <float> bar4-h: 3.0;
    in-out property <float> bar5-h: 3.0;

    callback cycle-state();
    callback select-state(int);
    callback select-option(int);
    callback set-opacity(float);
    callback set-bg(int);

    pure function stage-bg() -> color {
        if (root.bg-mode == 1) { return Theme.stage-slate; }
        if (root.bg-mode == 2) { return Theme.black; }
        if (root.bg-mode == 3) { return Theme.white; }
        return Theme.stage-ide;
    }

    pure function mock-code-color() -> color {
        return root.bg-mode == 3 ? Theme.ink-faint : Theme.stage-ink;
    }

    pure function opt-a-label() -> string {
        if (root.active-state == 0) { return "A: Micro Mic (48px)"; }
        if (root.active-state == 1) { return "A: 3-Bar Wave + Timer"; }
        if (root.active-state == 2) { return "A: Hairline Orbit"; }
        if (root.active-state == 3) { return "A: Minimal Check"; }
        return "A: Exclamation Alert";
    }

    pure function opt-b-label() -> string {
        if (root.active-state == 0) { return "B: Standby LED (44px)"; }
        if (root.active-state == 1) { return "B: Quintet 5-Bar Wave"; }
        if (root.active-state == 2) { return "B: Sine Wave Ripple"; }
        if (root.active-state == 3) { return "B: Ring Check"; }
        return "B: Breath Loop";
    }

    pure function opt-c-label() -> string {
        if (root.active-state == 0) { return "C: Edge Accent (56px)"; }
        if (root.active-state == 1) { return "C: Pulse Ring + Timer"; }
        if (root.active-state == 2) { return "C: Radar Ping-Pong"; }
        if (root.active-state == 3) { return "C: Double Pip"; }
        return "C: Triangle Flash";
    }

    pure function telemetry-dim() -> string {
        let opt = root.active-option();
        if (root.active-state == 0) {
            return opt == 1 ? "44 x 32 px (LED)" : (opt == 2 ? "56 x 32 px (Focus)" : "48 x 32 px (Standard)");
        }
        if (root.active-state == 1) {
            return opt == 1 ? "84 x 32 px (5-Bar)" : (opt == 2 ? "100 x 32 px (Pulse Ring)" : "112 x 32 px (Waveform)");
        }
        if (root.active-state == 2) {
            return opt == 1 ? "76 x 32 px (Ripple)" : (opt == 2 ? "80 x 32 px (Radar)" : "72 x 32 px (Orbit)");
        }
        if (root.active-state == 3) {
            return opt == 1 ? "64 x 32 px (Ring Check)" : (opt == 2 ? "68 x 32 px (Double Check)" : "60 x 32 px (Minimal)");
        }
        return opt == 2 ? "64 x 32 px (Triangle Flash)" : "60 x 32 px (Standard)";
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: Theme.space-24;
        spacing: Theme.space-16;

            // =====================================================================
            // HEADER: SHADCN / LINEAR MINIMALIST WITH STATUS PILL
            // =====================================================================
            HorizontalLayout {
                alignment: space-between;

                // Integrated Brand Lockup (transparent SVG waveform mark + optical Playfair SVG wordmark)
                brand-logo := HorizontalLayout {
                    height: 36px;
                    spacing: Theme.space-8;
                    alignment: start;
                    accessible-role: text;
                    accessible-label: "Sotto";

                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 28px;
                            height: 28px;
                            source: @image-url("../assets/icons/sotto-tray-dark.svg");
                            colorize: Theme.ink-primary;
                            image-fit: contain;
                            image-rendering: smooth;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 72px;
                            height: 23px;
                            source: @image-url("../assets/icons/sotto-wordmark.svg");
                            colorize: Theme.ink-primary;
                            image-fit: contain;
                            image-rendering: smooth;
                        }
                    }
                }

            // Top Action Controls: Segmented Top Tab Bar Capsule
            studio-tabs := TabBar {
                active-tab <=> root.active-tab;
                select-tab(index) => {
                    root.select-tab(index);
                }
            }
        }

        // =====================================================================
        // UNIFIED CONTENT CONTAINER (Zero Layout Mutation on Tab Switch)
        // =====================================================================
        content-area := Rectangle {
            vertical-stretch: 1;

            // TAB 0: DICTATIONS HISTORY (High-DPI Razor Sharp & Virtualized)
            VerticalLayout {
                visible: root.active-tab == 0;
                width: parent.width;
                height: parent.height;
                spacing: Theme.space-12;

            // Subheader & Stats Bar (shadcn Card)
            stats-bar := Rectangle {
                background: Theme.card-bg;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.line;
                height: 44px;

                // Specular Top Sheen
                Rectangle {
                    y: 1px; x: 10px; width: parent.width - 20px; height: 1px;
                    background: Theme.white; opacity: 0.04;
                }

                HorizontalLayout {
                    padding-left: Theme.space-16;
                    padding-right: Theme.space-16;
                    alignment: space-between;

                    // Modern Telemetry Chips (vertically centered in the 44px bar)
                    chips-row := VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.space-8;
                            alignment: start;

                        StatChip {
                            icon-svg: @image-url("../assets/icons/layers.svg");
                            has-svg: true;
                            label: root.history-count + " Dictations";
                            accent: true;
                        }

                        StatChip {
                            icon-svg: @image-url("../assets/icons/lock.svg");
                            has-svg: true;
                            label: "SQLite WAL Local";
                        }

                        StatChip {
                            icon-svg: root.provider-id == "gemini"
                                ? @image-url("../assets/icons/sparkle.svg")
                                : @image-url("../assets/icons/bolt.svg");
                            has-svg: true;
                            label: root.provider-chip-text;
                        }
                    }
                    }

                    // Actions Row (vertically centered in the 44px bar)
                    actions-row := VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: Theme.space-8;
                            alignment: end;

                            if root.history-count > 0 && root.purge-confirm-armed : purge-cancel-btn := Rectangle {
                                width: 62px;
                                height: 26px;
                                border-radius: Theme.radius-md;
                                background: cancel-purge-touch.pressed ? Theme.line-strong : (cancel-purge-touch.has-hover ? Theme.line : Theme.chrome-bg);
                                border-width: 1px;
                                border-color: cancel-purge-touch.has-hover ? Theme.line-strong : Theme.line;

                                Text {
                                    text: "Cancel";
                                    font-size: Theme.type-label.size;
                                    font-weight: 500;
                                    color: cancel-purge-touch.has-hover ? Theme.white : Theme.ink-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                cancel-purge-touch := TouchArea {
                                    clicked => {
                                        root.purge-confirm-armed = false;
                                    }
                                }
                            }

                            if root.history-count > 0 : purge-btn := Rectangle {
                                width: root.purge-confirm-armed ? 112px : 96px;
                                height: 26px;
                                border-radius: Theme.radius-md;
                                background: root.purge-confirm-armed
                                    ? (clear-touch.pressed ? Theme.danger-pressed : (clear-touch.has-hover ? Theme.danger : Theme.danger-hover))
                                    : (clear-touch.pressed ? Theme.danger-pressed : (clear-touch.has-hover ? Theme.danger-hover : Theme.chrome-bg));
                                border-width: 1px;
                                border-color: (root.purge-confirm-armed || clear-touch.has-hover) ? Theme.danger : Theme.line;

                                Text {
                                    text: root.purge-confirm-armed ? "Confirm Purge" : "Purge Data";
                                    font-size: Theme.type-label.size;
                                    font-weight: 500;
                                    color: root.purge-confirm-armed
                                        ? (clear-touch.has-hover ? Theme.white : Theme.danger-soft)
                                        : (clear-touch.has-hover ? Theme.danger-soft : Theme.ink-secondary);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                clear-touch := TouchArea {
                                    clicked => {
                                        if (!root.purge-confirm-armed) {
                                            root.purge-confirm-armed = true;
                                        } else {
                                            root.purge-confirm-armed = false;
                                            root.clear-all-history();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =================================================================
            // HISTORY VAULT CONTAINER (Always alive to prevent DOM reconstruction - R14)
            // =================================================================
            history-container := Rectangle {
                vertical-stretch: 1;
                clip: true;

                history-list := Flickable {
                    interactive: false;
                    width: (root.history-content-height > parent.height && root.history-count > 0)
                        ? (parent.width - 22px)
                        : parent.width;
                    height: parent.height;
                    visible: root.history-count > 0;
                    content-height: root.history-content-height;
                    content-y: root.history-viewport-y;

                    VerticalLayout {
                        alignment: start;
                        padding-right: (root.history-content-height > history-container.height && root.history-count > 0)
                            ? Theme.space-12
                            : Theme.space-0;
                        padding-bottom: Theme.space-16;
                        spacing: Theme.space-8;

                        if root.history-virtualized && root.top-spacer-height > 0px : Rectangle {
                            height: root.top-spacer-height;
                            background: transparent;
                        }

                        for entry in (root.history-virtualized ? root.visible-history-items : root.history-items) : HistoryCard {
                            rec-id: entry.id;
                            rec-timestamp: entry.timestamp-str;
                            rec-transcript: entry.transcript;
                            rec-duration-ms: entry.duration-ms;
                            rec-duration-str: entry.duration-str;
                            rec-target-app: entry.target-app;
                            rec-app-icon: entry.app-icon;
                            rec-has-icon: entry.has-icon;
                            copied-id: root.copied-item-id;
                            copy-item(id, text) => {
                                root.copy-history-item(id, text);
                            }
                        }

                        if root.history-virtualized && root.bottom-spacer-height > 0px : Rectangle {
                            height: root.bottom-spacer-height;
                            background: transparent;
                        }
                    }
                }

                // Top Vignette Edge Shadow
                Rectangle {
                    y: 0px;
                    x: 0px;
                    width: parent.width;
                    height: 18px;
                    background: @linear-gradient(180deg, Theme.vignette 0%, transparent 100%);
                    opacity: (root.history-count > 0 && root.history-scroll-progress > 0.01) ? 1.0 : 0.0;
                    animate opacity { duration: 180ms; easing: ease-out; }
                }

                // Bottom Vignette Edge Shadow
                Rectangle {
                    y: parent.height - 18px;
                    x: 0px;
                    width: parent.width;
                    height: 18px;
                    background: @linear-gradient(0deg, Theme.vignette 0%, transparent 100%);
                    opacity: (root.history-count > 0 && root.history-can-scroll && root.history-scroll-progress < 0.99) ? 1.0 : 0.0;
                    animate opacity { duration: 180ms; easing: ease-out; }
                }

                // Scrollbar gutter: dedicated 22px lane at the container edge so
                // the track never overlaps card content.
                scroll-gutter := Rectangle {
                    x: parent.width - 22px;
                    y: 0px;
                    width: 22px;
                    height: parent.height;

                // Modern Glass Scrollbar Indicator (Syncs with Lenis Physics + Drag - R10)
                if (root.history-content-height > parent.height) && root.history-count > 0 : scrollbar-track := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 4px;
                    width: 10px;
                    height: parent.height - 8px;
                    background: Theme.gutter-bg;
                    border-radius: 5px;

                    // Scrollbar Thumb
                    scrollbar-thumb := Rectangle {
                        property <length> thumb-height: Math.max(36px, parent.height * (parent.height / Math.max(1px, root.history-content-height)));
                        property <float> scroll-ratio: (root.history-content-height > parent.height && (root.history-content-height - parent.height) > 0px)
                            ? Math.min(1.0, Math.max(0.0, (-root.history-viewport-y) / (root.history-content-height - parent.height)))
                            : 0.0;
                        width: (track-touch.pressed || track-touch.has-hover) ? 6px : 4px;
                        x: (parent.width - self.width) / 2;
                        height: self.thumb-height;
                        y: self.scroll-ratio * (parent.height - self.thumb-height);
                        border-radius: self.width / 2;
                        background: track-touch.pressed ? Theme.ink-muted : (track-touch.has-hover ? Theme.ink-faint : Theme.line-strong);
                        opacity: track-touch.pressed ? 0.85 : (track-touch.has-hover ? 0.7 : 0.4);
                    }

                    track-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        moved => {
                            if (self.pressed) {
                                let thumb-h = scrollbar-thumb.thumb-height;
                                let avail = parent.height - thumb-h;
                                let norm = avail > 0px ? Math.min(1.0, Math.max(0.0, (self.mouse-y - thumb-h * 0.5) / avail)) : 0.0;
                                root.history-drag-scroll(norm);
                            }
                        }
                        clicked => {
                            let thumb-h = scrollbar-thumb.thumb-height;
                            let avail = parent.height - thumb-h;
                            let norm = avail > 0px ? Math.min(1.0, Math.max(0.0, (self.mouse-y - thumb-h * 0.5) / avail)) : 0.0;
                            root.history-drag-scroll(norm);
                        }
                    }
                }
                }

                // HERO EMPTY STATE (Lives inside history-container, toggles visibility - R14)
                if root.history-count == 0 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-lg;
                    background: Theme.card-bg;
                    border-width: 1px;
                    border-color: Theme.line;

                    // Specular Top Line
                    Rectangle {
                        y: 1px; x: 12px; width: parent.width - 24px; height: 1px;
                        background: Theme.white; opacity: 0.08;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-16;
                        padding: Theme.space-32;

                        // Concentric Radar Soundwave Rings
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 72px;
                                height: 72px;
                                border-radius: 36px;
                                background: Theme.chrome-bg;
                                border-width: 1px;
                                border-color: Theme.line;

                                Rectangle {
                                    width: 48px;
                                    height: 48px;
                                    border-radius: 24px;
                                    background: Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;

                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: Theme.radius-lg;
                                        background: Theme.ink-primary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }

                        // Hero Text
                        VerticalLayout {
                            spacing: Theme.space-4;
                            Text {
                                text: "Your Dictations are Ready";
                                font-size: Theme.type-hero.size;
                                font-weight: Theme.type-hero.weight;
                                font-family: Theme.type-hero.family;
                                letter-spacing: -0.4px;
                                color: Theme.ink-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Press your global hotkey in any application to capture and dictate speech in real time.";
                                font-size: Theme.type-title.size;
                                color: Theme.ink-secondary;
                                horizontal-alignment: center;
                            }
                        }

                        // Hotkey Action Prompt (shadcn <kbd>)
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.space-4;

                            Rectangle {
                                background: Theme.chrome-bg;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: Theme.line;
                                height: 24px;
                                HorizontalLayout {
                                    padding-left: Theme.space-8; padding-right: Theme.space-8;
                                    Text {
                                        text: "Ctrl";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                                        }
                                }
                            }

                            Text { text: "+"; font-size: Theme.type-caption.size; color: Theme.ink-faint; vertical-alignment: center; }

                            Rectangle {
                                background: Theme.chrome-bg;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: Theme.line;
                                height: 24px;
                                HorizontalLayout {
                                    padding-left: Theme.space-8; padding-right: Theme.space-8;
                                    Text {
                                        text: "Shift";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                                        }
                                }
                            }

                            Text { text: "+"; font-size: Theme.type-caption.size; color: Theme.ink-faint; vertical-alignment: center; }

                            Rectangle {
                                background: Theme.chrome-bg;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: Theme.line;
                                height: 24px;
                                HorizontalLayout {
                                    padding-left: Theme.space-12; padding-right: Theme.space-12;
                                    Text {
                                        text: "Space";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                                        }
                                }
                            }
                        }

                        // Feature Highlights Row
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.space-12;

                            StatChip {
                                chip-height: 24px;
                                icon-svg: @image-url("../assets/icons/lock.svg");
                                has-svg: true;
                                label: "100% On-Device SQLite WAL";
                            }

                            StatChip {
                                chip-height: 24px;
                                icon-svg: root.provider-id == "gemini"
                                    ? @image-url("../assets/icons/sparkle.svg")
                                    : @image-url("../assets/icons/bolt.svg");
                                has-svg: true;
                                label: root.provider-chip-text;
                            }

                            StatChip {
                                chip-height: 24px;
                                icon-svg: @image-url("../assets/icons/cursor.svg");
                                has-svg: true;
                                label: "Instant Cursor Injection";
                            }
                        }
                    }
                }
            }
        }

            // =====================================================================
            // =====================================================================
            // TAB 1: TRANSCRIPTION PROVIDERS (Keys, Models, Connection Test)
            // =====================================================================
            providers_container := Rectangle {
                visible: root.active-tab == 1;
                width: parent.width;
                height: parent.height;
                clip: true;

                providers_flick := Flickable {
                    width: root.providers-can-scroll ? (parent.width - Theme.space-16) : parent.width;
                    height: parent.height;
                    content-height: root.providers-content-height;
                    content-y: root.providers-viewport-y;
                    interactive: false;

                    providers_content_layout := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.space-24;
                        padding-right: Theme.space-0;
                        padding-bottom: Theme.space-32;

                    // Section header
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center;
                            SectionHeader {
                                title: "TRANSCRIPTION PROVIDER";
                                subtitle: "Select your speech-to-text engine. Keys stay encrypted in local SQLite.";
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoTooltip {
                                align-right: true;
                                tip: "Sotto connects directly from your machine to Groq or Google Gemini via pre-warmed HTTP/2 streaming. Audio is processed entirely in RAM with zero disk writes.";
                            }
                        }
                    }

                    // Two side-by-side provider cards
                    HorizontalLayout {
                        spacing: Theme.space-16;

                        // Card: Groq
                        ProviderCard {
                            horizontal-stretch: 1;
                            logo: @image-url("../assets/icons/groq.svg");
                            logo-w: 56;
                            logo-h: 20;
                            title: "";
                            selected: root.provider-id == "groq";
                            clicked => {
                                root.select-provider("groq");
                            }
                        }

                        // Card: Gemini
                        ProviderCard {
                            horizontal-stretch: 1;
                            logo: @image-url("../assets/icons/gemini.svg");
                            logo-w: 20;
                            logo-h: 20;
                            title: "Gemini";
                            selected: root.provider-id == "gemini";
                            clicked => {
                                root.select-provider("gemini");
                            }
                        }
                    }

                    // Active provider key + models (Groq)
                    if root.provider-id == "groq" : VerticalLayout {
                        spacing: Theme.space-8;

                        KeyPoolManager {
                            label: "GROQ API KEY ROUTER";
                            keys: root.groq-key-pool;
                            new-key-text <=> root.groq-new-key;
                            placeholder: "gsk_... (Paste additional key to auto-rotate)";
                            console-label: "console.groq.com ↗";
                            add-key(k) => {
                                root.add-provider-key("groq", k);
                            }
                            remove-key(k) => {
                                root.remove-provider-key("groq", k);
                            }
                            open-site => {
                                root.open-provider-site("groq");
                            }
                        }

                        Text {
                            text: "GROQ MODELS";
                            font-size: Theme.type-eyebrow.size;
                            font-weight: 600;
                            color: Theme.ink-secondary;
                            font-family: Theme.font-mono;
                            letter-spacing: 0.5px;
                        }

                        VerticalLayout {
                            spacing: Theme.space-8;

                            for m[gidx] in root.groq-models : ModelRow {
                                name: m;
                                selected: root.groq-model-index == gidx;
                                clicked => {
                                    root.groq-model-index = gidx;
                                    root.model-changed("groq", gidx);
                                }
                            }
                        }
                    }

                    // Active provider key + models (Gemini)
                    if root.provider-id == "gemini" : VerticalLayout {
                        spacing: Theme.space-8;

                        KeyPoolManager {
                            label: "GEMINI API KEY ROUTER";
                            keys: root.gemini-key-pool;
                            new-key-text <=> root.gemini-new-key;
                            placeholder: "AIza... (Paste additional key to auto-rotate)";
                            console-label: "aistudio.google.com ↗";
                            add-key(k) => {
                                root.add-provider-key("gemini", k);
                            }
                            remove-key(k) => {
                                root.remove-provider-key("gemini", k);
                            }
                            open-site => {
                                root.open-provider-site("gemini");
                            }
                        }

                        Text {
                            text: "GEMINI MODELS";
                            font-size: Theme.type-eyebrow.size;
                            font-weight: 600;
                            color: Theme.ink-secondary;
                            font-family: Theme.font-mono;
                            letter-spacing: 0.5px;
                        }

                        VerticalLayout {
                            spacing: Theme.space-8;

                            for m[gidx] in root.gemini-models : ModelRow {
                                name: m;
                                selected: root.gemini-model-index == gidx;
                                clicked => {
                                    root.gemini-model-index = gidx;
                                    root.model-changed("gemini", gidx);
                                }
                            }
                        }
                    }

                    // Transcription Language Section
                    VerticalLayout {
                        spacing: Theme.space-8;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "TRANSCRIPTION LANGUAGE";
                                font-size: Theme.type-eyebrow.size;
                                font-weight: Theme.type-eyebrow.weight;
                                color: Theme.ink-secondary;
                                font-family: Theme.font-mono;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }
                            InfoTooltip {
                                align-right: true;
                                tip: "Auto-Detect supports 99+ languages. For lowest latency and highest punctuation precision in English, select English.";
                            }
                        }

                        if !root.model-supports-multilingual : HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-8;

                            Rectangle {
                                width: 120px;
                                height: 34px;
                                border-radius: Theme.radius-sm;
                                background: Theme.selected-bg;
                                border-width: 1px;
                                border-color: Theme.accent;

                                Text {
                                    text: "English (en)";
                                    font-size: Theme.type-label.size;
                                    font-weight: 600;
                                    color: Theme.ink-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 34px;
                                border-radius: Theme.radius-sm;
                                background: Theme.chrome-bg;
                                border-width: 1px;
                                border-color: Theme.line;

                                HorizontalLayout {
                                    padding-left: Theme.space-8;
                                    padding-right: Theme.space-8;
                                    alignment: center;

                                    Text {
                                        text: "Model is English-only";
                                        font-size: Theme.type-caption.size;
                                        color: Theme.ink-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.model-supports-multilingual : VerticalLayout {
                            spacing: Theme.space-8;

                            HorizontalLayout {
                                spacing: Theme.space-8;
                                alignment: start;

                                // Option 1: English
                                Rectangle {
                                    width: 100px;
                                    height: 34px;
                                    border-radius: Theme.radius-sm;
                                    background: root.transcription-language == "en" ? Theme.selected-bg : Theme.sunken-bg;
                                    border-width: 1px;
                                    border-color: root.transcription-language == "en" ? Theme.accent : Theme.line;
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    Text {
                                        text: "English";
                                        font-size: Theme.type-label.size;
                                        font-weight: root.transcription-language == "en" ? 600 : 500;
                                        color: root.transcription-language == "en" ? Theme.ink-primary : Theme.ink-alt;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.select-language("en");
                                        }
                                    }
                                }

                                // Option 2: Auto-Detect
                                Rectangle {
                                    width: 110px;
                                    height: 34px;
                                    border-radius: Theme.radius-sm;
                                    background: root.transcription-language == "auto" ? Theme.selected-bg : Theme.sunken-bg;
                                    border-width: 1px;
                                    border-color: root.transcription-language == "auto" ? Theme.accent : Theme.line;
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    Text {
                                        text: "Auto-Detect";
                                        font-size: Theme.type-label.size;
                                        font-weight: root.transcription-language == "auto" ? 600 : 500;
                                        color: root.transcription-language == "auto" ? Theme.ink-primary : Theme.ink-alt;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.select-language("auto");
                                        }
                                    }
                                }

                                // Option 3: More Languages Dropdown
                                Rectangle {
                                    min-width: 150px;
                                    height: 34px;
                                    border-radius: Theme.radius-sm;
                                    background: (root.transcription-language != "en" && root.transcription-language != "auto") ? Theme.selected-bg : Theme.sunken-bg;
                                    border-width: 1px;
                                    border-color: (root.transcription-language != "en" && root.transcription-language != "auto") ? Theme.accent : (root.language-dropdown-open ? Theme.line-strong : Theme.line);
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-12;
                                        padding-right: Theme.space-12;
                                        spacing: Theme.space-4;
                                        alignment: center;

                                        Text {
                                            text: root.selected-other-language-display;
                                            font-size: Theme.type-label.size;
                                            font-weight: (root.transcription-language != "en" && root.transcription-language != "auto") ? 600 : 500;
                                            color: (root.transcription-language != "en" && root.transcription-language != "auto") ? Theme.ink-primary : Theme.ink-alt;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: root.language-dropdown-open
                                                    ? @image-url("../assets/icons/chevron-up.svg")
                                                    : @image-url("../assets/icons/chevron-down.svg");
                                                width: 12px;
                                                height: 12px;
                                                colorize: (root.transcription-language != "en" && root.transcription-language != "auto") ? Theme.ink-primary : Theme.ink-muted;
                                                image-fit: contain;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.toggle-language-dropdown();
                                        }
                                    }
                                }
                            }

                            // 2-Column Dropdown
                            if root.language-dropdown-open : Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.card-bg;
                                border-width: 1px;
                                border-color: Theme.line-strong;

                                HorizontalLayout {
                                    padding: Theme.space-8;
                                    spacing: Theme.space-8;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Theme.space-2;

                                        for lang in root.other-languages-col1 : Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: lang.code == root.transcription-language ? Theme.selected-bg : (c1-touch.has-hover ? Theme.chrome-bg : transparent);
                                            border-width: lang.code == root.transcription-language ? 1px : 0px;
                                            border-color: Theme.accent;

                                            HorizontalLayout {
                                                padding-left: Theme.space-8;
                                                padding-right: Theme.space-8;
                                                alignment: space-between;

                                                Text {
                                                    text: lang.name;
                                                    font-size: Theme.type-caption.size;
                                                    font-weight: lang.code == root.transcription-language ? 600 : 400;
                                                    color: lang.code == root.transcription-language ? Theme.accent : Theme.ink-primary;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: lang.code;
                                                    font-size: Theme.type-caption.size;
                                                    font-family: Theme.font-mono;
                                                    color: Theme.ink-muted;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            c1-touch := TouchArea {
                                                clicked => {
                                                    root.select-language(lang.code);
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Theme.space-2;

                                        for lang in root.other-languages-col2 : Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            background: lang.code == root.transcription-language ? Theme.selected-bg : (c2-touch.has-hover ? Theme.chrome-bg : transparent);
                                            border-width: lang.code == root.transcription-language ? 1px : 0px;
                                            border-color: Theme.accent;

                                            HorizontalLayout {
                                                padding-left: Theme.space-8;
                                                padding-right: Theme.space-8;
                                                alignment: space-between;

                                                Text {
                                                    text: lang.name;
                                                    font-size: Theme.type-caption.size;
                                                    font-weight: lang.code == root.transcription-language ? 600 : 400;
                                                    color: lang.code == root.transcription-language ? Theme.accent : Theme.ink-primary;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: lang.code;
                                                    font-size: Theme.type-caption.size;
                                                    font-family: Theme.font-mono;
                                                    color: Theme.ink-muted;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            c2-touch := TouchArea {
                                                clicked => {
                                                    root.select-language(lang.code);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =================================================================
                    // AI POST-PROCESSING / SMART POLISH (Optional)
                    // =================================================================
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            alignment: center;
                            SectionHeader {
                                title: "AI SMART POLISH (POST-PROCESSING)";
                                subtitle: "Instant grammar correction and context-aware formatting.";
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoTooltip {
                                align-right: true;
                                tip: "Dispatches raw speech instantly to a lightweight LLM before typing. Removes filler words and structures spoken code. Includes a 1.5s timeout safety fallback.";
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: root.post-process-llm-enabled ? Theme.accent : Theme.line;

                        VerticalLayout {
                            padding: Theme.space-24;
                            spacing: Theme.space-16;

                            // Header row with Toggle
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: Theme.space-4;
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: Theme.space-8;
                                        Text {
                                            text: "Enable AI Smart Polish";
                                            font-size: Theme.type-title.size;
                                            font-weight: 600;
                                            color: Theme.ink-primary;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                border-radius: Theme.radius-sm;
                                                background: root.post-process-llm-enabled ? Theme.selected-bg : Theme.chrome-bg;
                                                border-width: 1px;
                                                border-color: root.post-process-llm-enabled ? Theme.accent : Theme.line;
                                                height: 20px;
                                                HorizontalLayout {
                                                    padding-left: Theme.space-8;
                                                    padding-right: Theme.space-8;
                                                    Text {
                                                        text: root.post-process-llm-enabled ? "Active (~200ms)" : "Off (Fastest 0ms)";
                                                        font-size: Theme.type-meta.size;
                                                        font-family: Theme.font-mono;
                                                        font-weight: 600;
                                                        color: root.post-process-llm-enabled ? Theme.accent : Theme.ink-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.post-process-llm-enabled 
                                            ? "Dispatches raw transcription instantly to LLM with 1.5s hard-timeout safety fallback." 
                                            : "Disabled by default for pure zero-latency raw Whisper transcription.";
                                        font-size: Theme.type-caption.size;
                                        color: Theme.ink-muted;
                                    }
                                }

                                // Toggle Switch
                                Rectangle {
                                    width: 50px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: root.post-process-llm-enabled ? Theme.accent : Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: root.post-process-llm-enabled ? Theme.accent-deep : Theme.line-strong;

                                    Rectangle {
                                        x: root.post-process-llm-enabled ? 24px : 2px;
                                        y: 2px;
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: Theme.white;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.toggle-post-process-llm();
                                        }
                                    }
                                }
                            }

                            // If enabled, display LLM provider & model selectors
                            if root.post-process-llm-enabled : VerticalLayout {
                                spacing: Theme.space-16;

                                Rectangle { height: 1px; background: Theme.line; }

                                // Provider selector row
                                VerticalLayout {
                                    spacing: Theme.space-8;
                                    Text {
                                        text: "LLM INFERENCE ENGINE";
                                        font-size: Theme.type-eyebrow.size;
                                        font-weight: 700;
                                        font-family: Theme.font-mono;
                                        color: Theme.ink-muted;
                                        letter-spacing: 0.5px;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-8;
                                        // Groq button
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-llm-provider == "groq" ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-llm-provider == "groq" ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                padding-left: Theme.space-8;
                                                padding-right: Theme.space-8;
                                                alignment: center;
                                                spacing: Theme.space-4;
                                                Text {
                                                    text: "⚡ Groq LPU (Fastest ~150-200ms)";
                                                    font-size: Theme.type-body.size;
                                                    font-weight: root.post-process-llm-provider == "groq" ? 600 : 400;
                                                    color: root.post-process-llm-provider == "groq" ? Theme.accent : Theme.ink-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-provider("groq");
                                                }
                                            }
                                        }

                                        // Gemini button
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-llm-provider == "gemini" ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-llm-provider == "gemini" ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                padding-left: Theme.space-8;
                                                padding-right: Theme.space-8;
                                                alignment: center;
                                                spacing: Theme.space-4;
                                                Text {
                                                    text: "✦ Gemini (High Limits & Precision)";
                                                    font-size: Theme.type-body.size;
                                                    font-weight: root.post-process-llm-provider == "gemini" ? 600 : 400;
                                                    color: root.post-process-llm-provider == "gemini" ? Theme.accent : Theme.ink-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-provider("gemini");
                                                }
                                            }
                                        }
                                    }
                                }

                                // Model selector row
                                VerticalLayout {
                                    spacing: Theme.space-8;
                                    Text {
                                        text: "TARGET MODEL";
                                        font-size: Theme.type-eyebrow.size;
                                        font-weight: 700;
                                        font-family: Theme.font-mono;
                                        color: Theme.ink-muted;
                                        letter-spacing: 0.5px;
                                    }

                                    if root.post-process-llm-provider == "groq" : HorizontalLayout {
                                        spacing: Theme.space-8;
                                        // Qwen 3.8 27B
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-llm-model == "qwen/qwen3.8-27b" ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-llm-model == "qwen/qwen3.8-27b" ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "qwen/qwen3.8-27b (Recommended)";
                                                font-size: Theme.type-body.size;
                                                font-family: Theme.font-mono;
                                                font-weight: root.post-process-llm-model == "qwen/qwen3.8-27b" ? 600 : 400;
                                                color: root.post-process-llm-model == "qwen/qwen3.8-27b" ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-model("qwen/qwen3.8-27b");
                                                }
                                            }
                                        }
                                        // GPT-OSS 120B
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-llm-model == "openai/gpt-oss-120b" ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-llm-model == "openai/gpt-oss-120b" ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "openai/gpt-oss-120b";
                                                font-size: Theme.type-body.size;
                                                font-family: Theme.font-mono;
                                                font-weight: root.post-process-llm-model == "openai/gpt-oss-120b" ? 600 : 400;
                                                color: root.post-process-llm-model == "openai/gpt-oss-120b" ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-model("openai/gpt-oss-120b");
                                                }
                                            }
                                        }
                                    }

                                    if root.post-process-llm-provider == "gemini" : HorizontalLayout {
                                        spacing: Theme.space-8;
                                        // Gemini 2.5 Flash
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-llm-model == "gemini-2.5-flash" ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-llm-model == "gemini-2.5-flash" ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "gemini-2.5-flash (Fastest)";
                                                font-size: Theme.type-body.size;
                                                font-family: Theme.font-mono;
                                                font-weight: root.post-process-llm-model == "gemini-2.5-flash" ? 600 : 400;
                                                color: root.post-process-llm-model == "gemini-2.5-flash" ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-model("gemini-2.5-flash");
                                                }
                                            }
                                        }
                                        // Gemini 2.5 Pro
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-llm-model == "gemini-2.5-pro" ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-llm-model == "gemini-2.5-pro" ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "gemini-2.5-pro (High Limits)";
                                                font-size: Theme.type-body.size;
                                                font-family: Theme.font-mono;
                                                font-weight: root.post-process-llm-model == "gemini-2.5-pro" ? 600 : 400;
                                                color: root.post-process-llm-model == "gemini-2.5-pro" ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-model("gemini-2.5-pro");
                                                }
                                            }
                                        }
                                        // Gemini 2.0 Flash
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-llm-model == "gemini-2.0-flash" ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-llm-model == "gemini-2.0-flash" ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "gemini-2.0-flash";
                                                font-size: Theme.type-body.size;
                                                font-family: Theme.font-mono;
                                                font-weight: root.post-process-llm-model == "gemini-2.0-flash" ? 600 : 400;
                                                color: root.post-process-llm-model == "gemini-2.0-flash" ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-model("gemini-2.0-flash");
                                                }
                                            }
                                        }
                                    }
                                }

                                // Style selector row
                                VerticalLayout {
                                    spacing: Theme.space-8;
                                    Text {
                                        text: "POLISH STYLE";
                                        font-size: Theme.type-eyebrow.size;
                                        font-weight: 700;
                                        font-family: Theme.font-mono;
                                        color: Theme.ink-muted;
                                        letter-spacing: 0.5px;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-8;
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-style == 0 ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-style == 0 ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Minimal (Punctuation & Grammar Only)";
                                                font-size: Theme.type-body.size;
                                                font-weight: root.post-process-style == 0 ? 600 : 400;
                                                color: root.post-process-style == 0 ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-style(0);
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 32px;
                                            border-radius: Theme.radius-sm;
                                            background: root.post-process-style == 1 ? Theme.selected-bg : Theme.chrome-bg;
                                            border-width: 1px;
                                            border-color: root.post-process-style == 1 ? Theme.accent : Theme.line;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "App Context-Aware (Auto Code / Chat / Doc)";
                                                font-size: Theme.type-body.size;
                                                font-weight: root.post-process-style == 1 ? 600 : 400;
                                                color: root.post-process-style == 1 ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-post-process-style(1);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Save + Test row
                    HorizontalLayout {
                        spacing: Theme.space-8;
                        alignment: start;

                        Rectangle {
                            width: 150px;
                            height: 36px;
                            border-radius: Theme.radius-md;
                            background: save-prov-touch.pressed ? Theme.action-pressed : (save-prov-touch.has-hover ? Theme.accent-deep : Theme.action-bg);
                            Text {
                                text: root.provider-save-feedback ? "Saved ✓" : "Save Providers";
                                font-size: Theme.type-title.size;
                                font-weight: 600;
                                color: Theme.white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            save-prov-touch := TouchArea {
                                clicked => {
                                    root.save-provider();
                                }
                            }
                        }

                        Rectangle {
                            width: 150px;
                            height: 36px;
                            border-radius: Theme.radius-md;
                            background: test-prov-touch.pressed ? Theme.line : (test-prov-touch.has-hover ? Theme.line : Theme.chrome-bg);
                            border-width: 1px;
                            border-color: Theme.line-strong;
                            Text {
                                text: root.provider-testing ? "Testing…" : "Test Connection";
                                font-size: Theme.type-title.size;
                                font-weight: 500;
                                color: Theme.ink-alt;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            test-prov-touch := TouchArea {
                                clicked => {
                                    root.test-provider();
                                }
                            }
                        }
                    }

                    // Status line
                    if root.provider-status != "" : Text {
                        text: root.provider-status;
                        font-size: Theme.type-label.size;
                        color: root.provider-status-ok ? Theme.success : Theme.error-soft;
                        wrap: word-wrap;
                    }
                }
            }

            // Top Vignette Edge Shadow
            Rectangle {
                y: 0px;
                x: 0px;
                width: parent.width;
                height: 18px;
                background: @linear-gradient(180deg, Theme.vignette 0%, transparent 100%);
                opacity: (root.providers-scroll-progress > 0.01) ? 1.0 : 0.0;
                animate opacity { duration: 180ms; easing: ease-out; }
            }

            // Bottom Vignette Edge Shadow
            Rectangle {
                y: parent.height - 18px;
                x: 0px;
                width: parent.width;
                height: 18px;
                background: @linear-gradient(0deg, Theme.vignette 0%, transparent 100%);
                opacity: (root.providers-can-scroll && root.providers-scroll-progress < 0.99) ? 1.0 : 0.0;
                animate opacity { duration: 180ms; easing: ease-out; }
            }

            // Modern Glass Scrollbar Indicator (Syncs with Lenis Physics + Drag)
            if (root.providers-can-scroll) : providers-scrollbar-track := Rectangle {
                x: parent.width - 6px;
                y: 4px;
                width: 4px;
                height: parent.height - 8px;
                background: transparent;

                providers-scrollbar-thumb := Rectangle {
                    width: 4px;
                    height: Math.max(28px, (parent.height) * (parent.height / Math.max(1px, root.providers-content-height)));
                    y: root.providers-scroll-progress * (parent.height - self.height);
                    border-radius: Theme.radius-pill;
                    background: root.providers-is-scrolling ? Theme.ink-muted : Theme.line-strong;
                    opacity: root.providers-is-scrolling ? 0.9 : 0.4;
                    animate opacity { duration: 200ms; }
                    animate background { duration: 200ms; }
                }

                providers-track-touch := TouchArea {
                    width: 24px;
                    x: -10px;
                    height: parent.height;

                    moved => {
                        if (self.pressed) {
                            let thumb-h = providers-scrollbar-thumb.height;
                            let avail = parent.height - thumb-h;
                            let norm_y = avail > 0px ? Math.min(1.0, Math.max(0.0, (self.mouse-y - thumb-h * 0.5) / avail)) : 0.0;
                            root.providers-drag-scroll(norm_y);
                        }
                    }
                    clicked => {
                        let thumb-h = providers-scrollbar-thumb.height;
                        let avail = parent.height - thumb-h;
                        let norm_y = avail > 0px ? Math.min(1.0, Math.max(0.0, (self.mouse-y - thumb-h * 0.5) / avail)) : 0.0;
                        root.providers-drag-scroll(norm_y);
                    }
                }
            }
        }

            // =====================================================================
            // =====================================================================
            // TAB 2: LIVE PILL CUSTOMIZATION & PREVIEW SUITE (Spacious & Smooth Virtualized)
            // =====================================================================
            custom_container := Rectangle {
                visible: root.active-tab == 2;
                width: parent.width;
                height: parent.height;
                clip: true;

                custom_flick := Flickable {
                    width: root.custom-can-scroll ? (parent.width - Theme.space-16) : parent.width;
                    height: parent.height;
                    content-height: root.custom-content-height;
                    content-y: root.custom-viewport-y;
                    interactive: false;

                    custom_content_layout := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.space-24;
                        padding-right: Theme.space-0;
                        padding-bottom: Theme.space-32;

                    // =================================================================
                    // SECTION 1: LIVE VOICE PILL PREVIEW STAGE
                    // =================================================================
                    stage-box := Rectangle {
                        background: root.stage-bg();
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.line;
                        height: 200px;
                        clip: true;

                        // Window Title Bar with Traffic Lights (pinned to top)
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 34px;
                            background: Theme.card-bg;

                            // Bottom hairline separator
                            Rectangle {
                                x: 0px;
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: Theme.line;
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-16;
                                padding-right: Theme.space-16;
                                alignment: space-between;

                                // Traffic Light Dots (Left)
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: Theme.space-8;
                                        alignment: start;
                                        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.danger; }
                                        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.amber-dot; }
                                        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.success-deep; }
                                    }
                                }

                                // Centered Stage Title
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: Theme.space-8;
                                        alignment: center;
                                        Text {
                                            text: "Voice Pill Live Stage";
                                            font-size: Theme.type-caption.size;
                                            font-weight: Theme.type-caption.weight;
                                            color: Theme.ink-secondary;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            InfoTooltip {
                                                tip: "Real-time preview of the floating overlay pill across its 5 lifecycle states and animation variants.";
                                            }
                                        }
                                    }
                                }

                                // Right Balancer (Equal width to traffic lights for symmetry)
                                Rectangle {
                                    width: 46px;
                                    height: 10px;
                                    background: transparent;
                                }
                            }
                        }

                        // Centered Voice Pill
                        VoicePill {
                            x: (parent.width - self.width) / 2;
                            y: 34px + (parent.height - 34px - self.height) / 2;
                            active-state: root.active-state;
                            opt-idle: root.opt-idle;
                            opt-listening: root.opt-listening;
                            opt-transcribe: root.opt-transcribe;
                            opt-success: root.opt-success;
                            opt-error: root.opt-error;
                            surface-opacity: root.surface-opacity;
                            anim-tick: root.anim-tick;
                            timer-sec: root.timer-sec;
                            timer-text: root.timer-text;
                            bar1-h: root.bar1-h;
                            bar2-h: root.bar2-h;
                            bar3-h: root.bar3-h;
                            bar4-h: root.bar4-h;
                            bar5-h: root.bar5-h;
                            clicked => { root.cycle-state(); }
                        }
                    }

                    // =================================================================
                    // BOX 1: VOICE PILL CUSTOMIZATION & PRESETS CARD
                    // =================================================================
                    custom_card := Rectangle {
                        background: Theme.card-bg;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.line;

                        // Specular Top Sheen
                        Rectangle {
                            y: 1px; x: 12px; width: parent.width - 24px; height: 1px;
                            background: Theme.white; opacity: 0.08;
                        }

                        VerticalLayout {
                            padding: Theme.space-24;
                            spacing: Theme.space-16;

                            // Section Header
                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: Theme.space-4;
                                    Text {
                                        text: "VOICE PILL PRESETS & BEHAVIOR";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                        letter-spacing: 0.5px;
                                    }
                                    Text {
                                        text: "HUD micro-animations, surface opacity, and interaction mode";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    InfoTooltip {
                                        align-right: true;
                                        tip: "Configure HUD micro-animations, surface translucency, and dictation mode. Presets persist across restarts.";
                                    }
                                }
                            }

                            // --- SUBSECTION A: LIFECYCLE STATE SWITCHER ---
                            VerticalLayout {
                                spacing: Theme.space-8;
                                Text {
                                    text: "LIFECYCLE STATE PREVIEW";
                                    font-size: Theme.type-eyebrow.size;
                                    font-weight: 600;
                                    color: Theme.ink-secondary;
                                    font-family: Theme.font-mono;
                                    letter-spacing: 0.5px;
                                }
                                Rectangle {
                                    height: 38px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    HorizontalLayout {
                                        padding: Theme.space-4;
                                        spacing: Theme.space-4;

                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-state == 0 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-state == 0 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: "Idle"; font-size: Theme.type-label.size; font-weight: root.active-state == 0 ? 600 : 500; color: root.active-state == 0 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-state(0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-state == 1 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-state == 1 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: "Listening"; font-size: Theme.type-label.size; font-weight: root.active-state == 1 ? 600 : 500; color: root.active-state == 1 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-state(1); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-state == 2 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-state == 2 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: "Transcribe"; font-size: Theme.type-label.size; font-weight: root.active-state == 2 ? 600 : 500; color: root.active-state == 2 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-state(2); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-state == 3 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-state == 3 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: "Success"; font-size: Theme.type-label.size; font-weight: root.active-state == 3 ? 600 : 500; color: root.active-state == 3 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-state(3); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-state == 4 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-state == 4 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: "Error"; font-size: Theme.type-label.size; font-weight: root.active-state == 4 ? 600 : 500; color: root.active-state == 4 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-state(4); } }
                                        }
                                    }
                                }
                            }

                            // --- SUBSECTION B: MODULAR DESIGN VARIANT ---
                            VerticalLayout {
                                spacing: Theme.space-8;
                                Text {
                                    text: "MODULAR DESIGN VARIANT";
                                    font-size: Theme.type-eyebrow.size;
                                    font-weight: 600;
                                    color: Theme.ink-secondary;
                                    font-family: Theme.font-mono;
                                    letter-spacing: 0.5px;
                                }
                                Rectangle {
                                    height: 38px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    HorizontalLayout {
                                        padding: Theme.space-4;
                                        spacing: Theme.space-4;

                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-option() == 0 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-option() == 0 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: root.opt-a-label(); font-size: Theme.type-label.size; font-weight: root.active-option() == 0 ? 600 : 500; color: root.active-option() == 0 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-option(0); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-option() == 1 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-option() == 1 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: root.opt-b-label(); font-size: Theme.type-label.size; font-weight: root.active-option() == 1 ? 600 : 500; color: root.active-option() == 1 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-option(1); } }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; border-radius: Theme.radius-sm;
                                            background: root.active-option() == 2 ? Theme.line : transparent;
                                            border-width: 1px;
                                            border-color: root.active-option() == 2 ? Theme.line-strong : transparent;
                                            Text { width: parent.width; height: parent.height; text: root.opt-c-label(); font-size: Theme.type-label.size; font-weight: root.active-option() == 2 ? 600 : 500; color: root.active-option() == 2 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { clicked => { root.select-option(2); } }
                                        }
                                    }
                                }
                            }

                            // --- SUBSECTION C: SURFACE OPACITY (TRANSPARENCY SLIDER) ---
                            VerticalLayout {
                                spacing: Theme.space-8;
                                Text {
                                    text: "SURFACE OPACITY (TRANSPARENCY)";
                                    font-size: Theme.type-eyebrow.size;
                                    font-weight: 600;
                                    color: Theme.ink-secondary;
                                    font-family: Theme.font-mono;
                                    letter-spacing: 0.5px;
                                }
                                Rectangle {
                                    height: 36px;
                                    background: transparent;

                                    HorizontalLayout {
                                        spacing: Theme.space-12;

                                        // Slider Track stretching across the space
                                        slider_box := Rectangle {
                                            horizontal-stretch: 1;
                                            height: 36px;

                                            // Track background
                                            Rectangle {
                                                y: (parent.height - 4px) / 2;
                                                width: parent.width;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: Theme.line;
                                            }

                                            // Active fill bar
                                            Rectangle {
                                                x: 0px;
                                                y: (parent.height - 4px) / 2;
                                                width: Math.clamp((root.surface-opacity - 0.20) / 0.80, 0.0, 1.0) * parent.width;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: Theme.ink-primary;
                                            }

                                            // Slider Thumb
                                            Rectangle {
                                                x: Math.clamp((root.surface-opacity - 0.20) / 0.80, 0.0, 1.0) * (parent.width - 18px);
                                                y: (parent.height - 18px) / 2;
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: Theme.white;
                                                border-width: 2px;
                                                border-color: Theme.chrome-bg;
                                                drop-shadow-blur: 4px;
                                                drop-shadow-color: #00000066;
                                            }

                                            TouchArea {
                                                pointer-event(event) => {
                                                    if (event.button == PointerEventButton.left) {
                                                        root.set-opacity(Math.clamp(0.20 + (self.mouse-x / parent.width) * 0.80, 0.20, 1.00));
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed) {
                                                        root.set-opacity(Math.clamp(0.20 + (self.mouse-x / parent.width) * 0.80, 0.20, 1.00));
                                                    }
                                                }
                                            }
                                        }

                                        // Live percentage readout (borderless monospace so it doesn't duplicate preset buttons)
                                        Text {
                                            width: 44px;
                                            height: 36px;
                                            text: Math.round(root.surface-opacity * 100) + "%";
                                            font-size: Theme.type-label.size;
                                            font-weight: 600;
                                            color: Theme.ink-primary;
                                            font-family: Theme.font-mono;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        // Quick preset pills (Uniform 52px width, centered text)
                                        HorizontalLayout {
                                            spacing: Theme.space-4;
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 52px; height: 32px; border-radius: Theme.radius-md;
                                                background: Math.round(root.surface-opacity * 100) == 50 ? Theme.selected-bg : Theme.chrome-bg;
                                                border-width: 1px; border-color: Math.round(root.surface-opacity * 100) == 50 ? Theme.accent : Theme.line;
                                                Text { width: parent.width; height: parent.height; text: "50%"; font-size: Theme.type-caption.size; font-weight: 500; color: Math.round(root.surface-opacity * 100) == 50 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.set-opacity(0.50); } }
                                            }
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 52px; height: 32px; border-radius: Theme.radius-md;
                                                background: Math.round(root.surface-opacity * 100) == 70 ? Theme.selected-bg : Theme.chrome-bg;
                                                border-width: 1px; border-color: Math.round(root.surface-opacity * 100) == 70 ? Theme.accent : Theme.line;
                                                Text { width: parent.width; height: parent.height; text: "70%"; font-size: Theme.type-caption.size; font-weight: 500; color: Math.round(root.surface-opacity * 100) == 70 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.set-opacity(0.70); } }
                                            }
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 52px; height: 32px; border-radius: Theme.radius-md;
                                                background: Math.round(root.surface-opacity * 100) == 85 ? Theme.selected-bg : Theme.chrome-bg;
                                                border-width: 1px; border-color: Math.round(root.surface-opacity * 100) == 85 ? Theme.accent : Theme.line;
                                                Text { width: parent.width; height: parent.height; text: "85%"; font-size: Theme.type-caption.size; font-weight: 500; color: Math.round(root.surface-opacity * 100) == 85 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.set-opacity(0.85); } }
                                            }
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 52px; height: 32px; border-radius: Theme.radius-md;
                                                background: Math.round(root.surface-opacity * 100) == 100 ? Theme.selected-bg : Theme.chrome-bg;
                                                border-width: 1px; border-color: Math.round(root.surface-opacity * 100) == 100 ? Theme.accent : Theme.line;
                                                Text { width: parent.width; height: parent.height; text: "100%"; font-size: Theme.type-caption.size; font-weight: 500; color: Math.round(root.surface-opacity * 100) == 100 ? Theme.ink-primary : Theme.ink-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.set-opacity(1.00); } }
                                            }
                                        }
                                    }
                                }
                            }

                            // Divider Line
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            // --- SUBSECTION D: SPEECH RECORDING BEHAVIOR ---
                            VerticalLayout {
                                spacing: Theme.space-12;

                                SectionHeader {
                                    title: "SPEECH RECORDING BEHAVIOR";
                                    subtitle: "Select interaction style for starting and stopping speech dictation";
                                }

                                // Two side-by-side generous cards (height: 68px, perfectly vertically centered)
                                HorizontalLayout {
                                    spacing: Theme.space-16;

                                    // Card 1: Hands-Free Toggle
                                    card_toggle := Rectangle {
                                        horizontal-stretch: 1;
                                        min-height: 68px;
                                        border-radius: Theme.radius-lg;
                                        background: root.trigger-mode == 0 ? Theme.selected-bg : (toggle_touch.has-hover ? Theme.chrome-bg : Theme.sunken-bg);
                                        border-width: 1px;
                                        border-color: root.trigger-mode == 0 ? Theme.accent : Theme.line;
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        HorizontalLayout {
                                            padding-left: Theme.space-16;
                                            padding-right: Theme.space-16;
                                            padding-top: Theme.space-12;
                                            padding-bottom: Theme.space-12;
                                            spacing: Theme.space-16;
                                            alignment: start;

                                            // Radio-style indicator dot (vertically centered in card)
                                            VerticalLayout {
                                                alignment: center;
                                                width: 20px;
                                                Rectangle {
                                                    width: 20px;
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: root.trigger-mode == 0 ? Theme.accent-deep : Theme.line;
                                                    border-width: 1px;
                                                    border-color: root.trigger-mode == 0 ? Theme.accent : Theme.line-strong;
                                                    if root.trigger-mode == 0 : Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: Theme.radius-sm;
                                                        background: Theme.ink-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                            }

                                            // Text block (vertically centered in card)
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: Theme.space-4;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: "Hands-Free Toggle";
                                                    font-size: Theme.type-title.size;
                                                    font-weight: 600;
                                                    color: root.trigger-mode == 0 ? Theme.ink-primary : Theme.ink-alt;
                                                }
                                                Text {
                                                    text: "Tap key once to start listening, tap again to stop";
                                                    font-size: Theme.type-label.size;
                                                    color: root.trigger-mode == 0 ? Theme.ink-secondary : Theme.ink-muted;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        toggle_touch := TouchArea {
                                            clicked => {
                                                root.set-trigger-mode(0);
                                            }
                                        }
                                    }

                                    // Card 2: Push to Talk (Hold)
                                    card_ptt := Rectangle {
                                        horizontal-stretch: 1;
                                        min-height: 68px;
                                        border-radius: Theme.radius-lg;
                                        background: root.trigger-mode == 1 ? Theme.selected-bg : (ptt_touch.has-hover ? Theme.chrome-bg : Theme.sunken-bg);
                                        border-width: 1px;
                                        border-color: root.trigger-mode == 1 ? Theme.accent : Theme.line;
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        HorizontalLayout {
                                            padding-left: Theme.space-16;
                                            padding-right: Theme.space-16;
                                            padding-top: Theme.space-12;
                                            padding-bottom: Theme.space-12;
                                            spacing: Theme.space-16;
                                            alignment: start;

                                            // Radio-style indicator dot (vertically centered in card)
                                            VerticalLayout {
                                                alignment: center;
                                                width: 20px;
                                                Rectangle {
                                                    width: 20px;
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: root.trigger-mode == 1 ? Theme.accent-deep : Theme.line;
                                                    border-width: 1px;
                                                    border-color: root.trigger-mode == 1 ? Theme.accent : Theme.line-strong;
                                                    if root.trigger-mode == 1 : Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: Theme.radius-sm;
                                                        background: Theme.ink-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                            }

                                            // Text block (vertically centered in card)
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: Theme.space-4;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: "Push to Talk (Hold)";
                                                    font-size: Theme.type-title.size;
                                                    font-weight: 600;
                                                    color: root.trigger-mode == 1 ? Theme.ink-primary : Theme.ink-alt;
                                                }
                                                Text {
                                                    text: "Hold key down continuously while speaking, release to transcribe";
                                                    font-size: Theme.type-label.size;
                                                    color: root.trigger-mode == 1 ? Theme.ink-secondary : Theme.ink-muted;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }

                                        ptt_touch := TouchArea {
                                            clicked => {
                                                root.set-trigger-mode(1);
                                            }
                                        }
                                    }
                                }
                            }

                            // Divider Line
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            // --- SUBSECTION E: MICROPHONE CAPTURE STRATEGY ---
                            VerticalLayout {
                                spacing: Theme.space-12;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        alignment: center;
                                        SectionHeader {
                                            title: "MICROPHONE CAPTURE STRATEGY";
                                            subtitle: "Audio input pipeline and Bluetooth profile management.";
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        InfoTooltip {
                                            align-right: true;
                                            tip: "Bluetooth headsets switch between A2DP (stereo music) and HFP/SCO (mono voice). Sotto's Dual-Mic Splice eliminates connection lag and keeps music in A2DP stereo when idle.";
                                        }
                                    }
                                }

                                // Card 1: Headset Always-On (legacy)
                                Rectangle {
                                    min-height: 76px;
                                    border-radius: Theme.radius-lg;
                                    background: root.capture-mode == 0 ? Theme.selected-bg : Theme.sunken-bg;
                                    border-width: 1px;
                                    border-color: root.capture-mode == 0 ? Theme.accent : Theme.line;
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-16;
                                        padding-right: Theme.space-16;
                                        padding-top: Theme.space-12;
                                        padding-bottom: Theme.space-12;
                                        spacing: Theme.space-16;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            width: 20px;
                                            Rectangle {
                                                width: 20px; height: 20px; border-radius: 10px;
                                                background: root.capture-mode == 0 ? Theme.accent-deep : Theme.line;
                                                border-width: 1px;
                                                border-color: root.capture-mode == 0 ? Theme.accent : Theme.line-strong;
                                                if root.capture-mode == 0 : Rectangle {
                                                    width: 8px; height: 8px; border-radius: Theme.radius-sm;
                                                    background: Theme.ink-primary;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: Theme.space-4;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Headset Always-On (Legacy)";
                                                font-size: Theme.type-title.size;
                                                font-weight: 600;
                                                color: root.capture-mode == 0 ? Theme.ink-primary : Theme.ink-alt;
                                            }
                                            Text {
                                                text: "Keeps headset mic locked open. Fastest repeat takes, but locks headset into call-quality audio.";
                                                font-size: Theme.type-label.size;
                                                font-weight: Theme.type-label.weight;
                                                color: Theme.ink-secondary;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.set-capture-mode(0); }
                                    }
                                }

                                // Card 2: Dual-Mic Splice (bridge)
                                Rectangle {
                                    min-height: 76px;
                                    border-radius: Theme.radius-lg;
                                    background: root.capture-mode == 1 ? Theme.selected-bg : Theme.sunken-bg;
                                    border-width: 1px;
                                    border-color: root.capture-mode == 1 ? Theme.accent : Theme.line;
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-16;
                                        padding-right: Theme.space-16;
                                        padding-top: Theme.space-12;
                                        padding-bottom: Theme.space-12;
                                        spacing: Theme.space-16;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            width: 20px;
                                            Rectangle {
                                                width: 20px; height: 20px; border-radius: 10px;
                                                background: root.capture-mode == 1 ? Theme.accent-deep : Theme.line;
                                                border-width: 1px;
                                                border-color: root.capture-mode == 1 ? Theme.accent : Theme.line-strong;
                                                if root.capture-mode == 1 : Rectangle {
                                                    width: 8px; height: 8px; border-radius: Theme.radius-sm;
                                                    background: Theme.ink-primary;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: Theme.space-4;
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                alignment: start;
                                                spacing: Theme.space-8;
                                                Text {
                                                    text: "Dual-Mic Splice";
                                                    font-size: Theme.type-title.size;
                                                    font-weight: 600;
                                                    color: root.capture-mode == 1 ? Theme.ink-primary : Theme.ink-alt;
                                                    vertical-alignment: center;
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 18px;
                                                        border-radius: Theme.radius-sm;
                                                        background: Theme.rec-idle-bg;
                                                        border-width: 1px;
                                                        border-color: Theme.success-dim;
                                                        HorizontalLayout {
                                                            padding-left: Theme.space-8;
                                                            padding-right: Theme.space-8;
                                                            Text {
                                                                text: "RECOMMENDED";
                                                                font-size: Theme.type-meta.size;
                                                                font-weight: 600;
                                                                font-family: Theme.font-mono;
                                                                color: Theme.success;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            Text {
                                                text: "Zero-latency 0ms trigger; releases headset stream to A2DP stereo after every take.";
                                                font-size: Theme.type-label.size;
                                                font-weight: Theme.type-label.weight;
                                                color: Theme.ink-secondary;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.set-capture-mode(1); }
                                    }
                                }

                                // Card 3: Onboard Only
                                Rectangle {
                                    min-height: 76px;
                                    border-radius: Theme.radius-lg;
                                    background: root.capture-mode == 2 ? Theme.selected-bg : Theme.sunken-bg;
                                    border-width: 1px;
                                    border-color: root.capture-mode == 2 ? Theme.accent : Theme.line;
                                    animate background { duration: 120ms; }
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-16;
                                        padding-right: Theme.space-16;
                                        padding-top: Theme.space-12;
                                        padding-bottom: Theme.space-12;
                                        spacing: Theme.space-16;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            width: 20px;
                                            Rectangle {
                                                width: 20px; height: 20px; border-radius: 10px;
                                                background: root.capture-mode == 2 ? Theme.accent-deep : Theme.line;
                                                border-width: 1px;
                                                border-color: root.capture-mode == 2 ? Theme.accent : Theme.line-strong;
                                                if root.capture-mode == 2 : Rectangle {
                                                    width: 8px; height: 8px; border-radius: Theme.radius-sm;
                                                    background: Theme.ink-primary;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: Theme.space-4;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Onboard Only";
                                                font-size: Theme.type-title.size;
                                                font-weight: 600;
                                                color: root.capture-mode == 2 ? Theme.ink-primary : Theme.ink-alt;
                                            }
                                            Text {
                                                text: "Never opens the headset mic. Bluetooth music stays pristine; records via laptop or USB microphone.";
                                                font-size: Theme.type-label.size;
                                                font-weight: Theme.type-label.weight;
                                                color: Theme.ink-secondary;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.set-capture-mode(2); }
                                    }
                                }
                            }

                            // Divider Line
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            // Integrated Save Preset Action Footer Bar
                            HorizontalLayout {
                                height: 40px;
                                alignment: space-between;

                                // Left status text and feedback (vertically centered)
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: Theme.space-8;
                                        alignment: start;

                                        if root.save-feedback : VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 8px; height: 8px; border-radius: Theme.radius-sm; background: Theme.success-deep;
                                            }
                                        }

                                        Text {
                                            text: root.save-feedback ? "Preset saved successfully to live floating pill" : "Pill presets & recording behavior persist across restarts";
                                            font-size: Theme.type-label.size;
                                            font-weight: root.save-feedback ? 600 : 400;
                                            color: root.save-feedback ? Theme.success-deep : Theme.ink-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Right Primary Save Preset Button (vertically centered)
                                VerticalLayout {
                                    alignment: center;
                                    save_btn := Rectangle {
                                        width: 130px;
                                        height: 34px;
                                        border-radius: Theme.radius-md;
                                        background: save_touch.pressed ? Theme.ink-alt : (save_touch.has-hover ? Theme.save-hover : Theme.ink-primary);
                                        border-width: 1px;
                                        border-color: Theme.ink-alt;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: #00000033;
                                        animate background { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Save Preset";
                                                font-size: Theme.type-title.size;
                                                font-weight: 600;
                                                color: Theme.input-bg;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        save_touch := TouchArea {
                                            clicked => {
                                                root.save-customization();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =================================================================
                    // BOX 2: ACTIVATION TRIGGER KEY CARD
                    // =================================================================
                    trigger_card := Rectangle {
                        background: Theme.card-bg;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.line;

                        // Specular Top Sheen
                        Rectangle {
                            y: 1px; x: 12px; width: parent.width - 24px; height: 1px;
                            background: Theme.white; opacity: 0.08;
                        }

                        VerticalLayout {
                            padding: Theme.space-24;
                            spacing: Theme.space-16;

                            // Section Header
                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: Theme.space-4;
                                    Text {
                                        text: "ACTIVATION TRIGGER SHORTCUTS";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                        letter-spacing: 0.5px;
                                    }
                                    Text {
                                        text: "Global shortcut to start and stop speech dictation across any application";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    InfoTooltip {
                                        align-right: true;
                                        tip: "Supports keys & mouse side buttons (max 5 keys). Left/Right click, Win, and Caps Lock are excluded. Remap mouse macros to F13–F24 if needed.";
                                    }
                                }
                            }

                            // Primary slot row: binding display + record + reset, all inline.
                            HorizontalLayout {
                                spacing: Theme.space-8;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 44px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: root.is-recording-key && root.recording-slot == 0 ? Theme.accent : Theme.line;
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-16;
                                        padding-right: Theme.space-16;
                                        spacing: Theme.space-12;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "PRIMARY";
                                                font-size: Theme.type-caption.size;
                                                font-weight: 600;
                                                color: Theme.ink-muted;
                                                font-family: Theme.font-mono;
                                                letter-spacing: 0.5px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 26px;
                                                border-radius: Theme.radius-sm;
                                                background: Theme.line;
                                                border-width: 1px;
                                                border-color: Theme.line-strong;
                                                HorizontalLayout {
                                                    padding-left: Theme.space-12;
                                                    padding-right: Theme.space-12;
                                                    Text {
                                                        text: root.trigger-primary-display;
                                                        font-size: Theme.type-label.size;
                                                        font-weight: 600;
                                                        color: Theme.ink-primary;
                                                        font-family: Theme.font-mono;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: root.is-recording-key && root.recording-slot == 0 ? Theme.rec-arm-alt : (rec_p_touch.has-hover ? Theme.line : Theme.chrome-bg);
                                        border-width: 1px;
                                        border-color: root.is-recording-key && root.recording-slot == 0 ? Theme.accent : (rec_p_touch.has-hover ? Theme.line-strong : Theme.line);
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.is-recording-key && root.recording-slot == 0 ? "Cancel" : "Record";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: root.is-recording-key && root.recording-slot == 0 ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        rec_p_touch := TouchArea {
                                            clicked => {
                                                if (root.is-recording-key && root.recording-slot == 0) {
                                                    root.stop-recording-key();
                                                } else {
                                                    root.start-recording-key(0);
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: reset_p_touch.has-hover ? Theme.line : Theme.chrome-bg;
                                        border-width: 1px;
                                        border-color: reset_p_touch.has-hover ? Theme.line-strong : Theme.line;
                                        animate background { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Reset to F8";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: reset_p_touch.has-hover ? Theme.ink-primary : Theme.ink-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        reset_p_touch := TouchArea {
                                            clicked => {
                                                root.reset-trigger(0);
                                            }
                                        }
                                    }
                                }
                            }

                            // Secondary slot row: same inline pattern (Clear empties it).
                            HorizontalLayout {
                                spacing: Theme.space-8;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 44px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: root.is-recording-key && root.recording-slot == 1 ? Theme.accent : Theme.line;
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-16;
                                        padding-right: Theme.space-16;
                                        spacing: Theme.space-12;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "SECONDARY";
                                                font-size: Theme.type-caption.size;
                                                font-weight: 600;
                                                color: Theme.ink-muted;
                                                font-family: Theme.font-mono;
                                                letter-spacing: 0.5px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 26px;
                                                border-radius: Theme.radius-sm;
                                                background: Theme.line;
                                                border-width: 1px;
                                                border-color: Theme.line-strong;
                                                HorizontalLayout {
                                                    padding-left: Theme.space-12;
                                                    padding-right: Theme.space-12;
                                                    Text {
                                                        text: root.trigger-secondary-display;
                                                        font-size: Theme.type-label.size;
                                                        font-weight: 600;
                                                        color: Theme.ink-primary;
                                                        font-family: Theme.font-mono;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: root.is-recording-key && root.recording-slot == 1 ? Theme.rec-arm-alt : (rec_s_touch.has-hover ? Theme.line : Theme.chrome-bg);
                                        border-width: 1px;
                                        border-color: root.is-recording-key && root.recording-slot == 1 ? Theme.accent : (rec_s_touch.has-hover ? Theme.line-strong : Theme.line);
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.is-recording-key && root.recording-slot == 1 ? "Cancel" : "Record";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: root.is-recording-key && root.recording-slot == 1 ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        rec_s_touch := TouchArea {
                                            clicked => {
                                                if (root.is-recording-key && root.recording-slot == 1) {
                                                    root.stop-recording-key();
                                                } else {
                                                    root.start-recording-key(1);
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: clear_s_touch.has-hover ? Theme.line : Theme.chrome-bg;
                                        border-width: 1px;
                                        border-color: clear_s_touch.has-hover ? Theme.line-strong : Theme.line;
                                        animate background { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Clear";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: clear_s_touch.has-hover ? Theme.ink-primary : Theme.ink-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        clear_s_touch := TouchArea {
                                            clicked => {
                                                root.reset-trigger(1);
                                            }
                                        }
                                    }
                                }
                            }

                            // Trigger tip & mouse hook status
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Tip: Press keyboard modifiers first, then mouse side buttons, to record chords.";
                                    font-size: Theme.type-caption.size;
                                    font-weight: Theme.type-caption.weight;
                                    color: Theme.ink-secondary;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Mouse hook: " + (root.mouse-hook-ready ? "ready" : "unavailable");
                                    font-size: Theme.type-caption.size;
                                    font-weight: Theme.type-caption.weight;
                                    font-family: Theme.font-mono;
                                    color: root.mouse-hook-ready ? Theme.ink-secondary : Theme.warning-soft;
                                    vertical-alignment: center;
                                }
                            }

                            mouse-poll-timer := Timer {
                                interval: 1500ms;
                                running: true;
                                triggered => {
                                    root.poll-mouse-hook();
                                }
                            }

                            // Divider Line
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            // Trigger status line (save confirmations, cap warnings)
                            if root.trigger-status != "" : Text {
                                text: root.trigger-status;
                                font-size: Theme.type-label.size;
                                color: Theme.ink-muted;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // =================================================================
                    // BOX 3: CANCEL TRIGGER KEYS CARD
                    // =================================================================
                    cancel_card := Rectangle {
                        background: Theme.card-bg;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.line;

                        // Specular Top Sheen
                        Rectangle {
                            y: 1px; x: 12px; width: parent.width - 24px; height: 1px;
                            background: Theme.white; opacity: 0.08;
                        }

                        VerticalLayout {
                            padding: Theme.space-24;
                            spacing: Theme.space-16;

                            // Section Header
                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: Theme.space-4;
                                    Text {
                                        text: "CANCEL TRIGGER SHORTCUTS";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                        letter-spacing: 0.5px;
                                    }
                                    Text {
                                        text: "Instantly abort voice dictation, discard audio, and restore Idle state";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    InfoTooltip {
                                        align-right: true;
                                        tip: "Triggering cancel immediately purges audio buffers from memory, drops outgoing network streams, and returns to Idle without pasting any text.";
                                    }
                                }
                            }

                            // Primary cancel slot row (Slot 2)
                            HorizontalLayout {
                                spacing: Theme.space-8;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 44px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: root.is-recording-key && root.recording-slot == 2 ? Theme.accent : Theme.line;
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-16;
                                        padding-right: Theme.space-16;
                                        spacing: Theme.space-12;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "PRIMARY CANCEL";
                                                font-size: Theme.type-caption.size;
                                                font-weight: 600;
                                                color: Theme.ink-muted;
                                                font-family: Theme.font-mono;
                                                letter-spacing: 0.5px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 26px;
                                                border-radius: Theme.radius-sm;
                                                background: Theme.line;
                                                border-width: 1px;
                                                border-color: Theme.line-strong;
                                                HorizontalLayout {
                                                    padding-left: Theme.space-12;
                                                    padding-right: Theme.space-12;
                                                    Text {
                                                        text: root.cancel-primary-display;
                                                        font-size: Theme.type-label.size;
                                                        font-weight: 600;
                                                        color: Theme.ink-primary;
                                                        font-family: Theme.font-mono;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: root.is-recording-key && root.recording-slot == 2 ? Theme.rec-arm-alt : (rec_cp_touch.has-hover ? Theme.line : Theme.chrome-bg);
                                        border-width: 1px;
                                        border-color: root.is-recording-key && root.recording-slot == 2 ? Theme.accent : (rec_cp_touch.has-hover ? Theme.line-strong : Theme.line);
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.is-recording-key && root.recording-slot == 2 ? "Cancel" : "Record";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: root.is-recording-key && root.recording-slot == 2 ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        rec_cp_touch := TouchArea {
                                            clicked => {
                                                if (root.is-recording-key && root.recording-slot == 2) {
                                                    root.stop-recording-key();
                                                } else {
                                                    root.start-recording-key(2);
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: reset_cp_touch.has-hover ? Theme.line : Theme.chrome-bg;
                                        border-width: 1px;
                                        border-color: reset_cp_touch.has-hover ? Theme.line-strong : Theme.line;
                                        animate background { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Reset to Esc";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: reset_cp_touch.has-hover ? Theme.ink-primary : Theme.ink-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        reset_cp_touch := TouchArea {
                                            clicked => {
                                                root.reset-trigger(2);
                                            }
                                        }
                                    }
                                }
                            }

                            // Secondary cancel slot row (Slot 3)
                            HorizontalLayout {
                                spacing: Theme.space-8;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 44px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.chrome-bg;
                                    border-width: 1px;
                                    border-color: root.is-recording-key && root.recording-slot == 3 ? Theme.accent : Theme.line;
                                    animate border-color { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: Theme.space-16;
                                        padding-right: Theme.space-16;
                                        spacing: Theme.space-12;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "SECONDARY CANCEL";
                                                font-size: Theme.type-caption.size;
                                                font-weight: 600;
                                                color: Theme.ink-muted;
                                                font-family: Theme.font-mono;
                                                letter-spacing: 0.5px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 26px;
                                                border-radius: Theme.radius-sm;
                                                background: Theme.line;
                                                border-width: 1px;
                                                border-color: Theme.line-strong;
                                                HorizontalLayout {
                                                    padding-left: Theme.space-12;
                                                    padding-right: Theme.space-12;
                                                    Text {
                                                        text: root.cancel-secondary-display;
                                                        font-size: Theme.type-label.size;
                                                        font-weight: 600;
                                                        color: Theme.ink-primary;
                                                        font-family: Theme.font-mono;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: root.is-recording-key && root.recording-slot == 3 ? Theme.rec-arm-alt : (rec_cs_touch.has-hover ? Theme.line : Theme.chrome-bg);
                                        border-width: 1px;
                                        border-color: root.is-recording-key && root.recording-slot == 3 ? Theme.accent : (rec_cs_touch.has-hover ? Theme.line-strong : Theme.line);
                                        animate background { duration: 120ms; }
                                        animate border-color { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.is-recording-key && root.recording-slot == 3 ? "Cancel" : "Record";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: root.is-recording-key && root.recording-slot == 3 ? Theme.accent : Theme.ink-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        rec_cs_touch := TouchArea {
                                            clicked => {
                                                if (root.is-recording-key && root.recording-slot == 3) {
                                                    root.stop-recording-key();
                                                } else {
                                                    root.start-recording-key(3);
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 112px;
                                        height: 44px;
                                        border-radius: Theme.radius-md;
                                        background: clear_cs_touch.has-hover ? Theme.line : Theme.chrome-bg;
                                        border-width: 1px;
                                        border-color: clear_cs_touch.has-hover ? Theme.line-strong : Theme.line;
                                        animate background { duration: 120ms; }

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Clear";
                                                font-size: Theme.type-label.size;
                                                font-weight: 500;
                                                color: clear_cs_touch.has-hover ? Theme.ink-primary : Theme.ink-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        clear_cs_touch := TouchArea {
                                            clicked => {
                                                root.reset-trigger(3);
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Tip: Cancel works mid-recording and mid-transcription with zero text injected.";
                                font-size: Theme.type-caption.size;
                                font-weight: Theme.type-caption.weight;
                                color: Theme.ink-secondary;
                            }
                        }
                    }

                    // =================================================================
                    // BOX 4: STARTUP & SYSTEM CARD
                    // =================================================================
                    startup_card := Rectangle {
                        background: Theme.card-bg;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.line;

                        // Specular Top Sheen
                        Rectangle {
                            y: 1px; x: 12px; width: parent.width - 24px; height: 1px;
                            background: Theme.white; opacity: 0.08;
                        }

                        VerticalLayout {
                            padding: Theme.space-24;
                            spacing: Theme.space-16;

                            // Section Header
                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: Theme.space-4;
                                    Text {
                                        text: "SYSTEM & STARTUP";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                        letter-spacing: 0.5px;
                                    }
                                    Text {
                                        text: "Background boot integration and system tray preferences";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    InfoTooltip {
                                        align-right: true;
                                        tip: "Registers Sotto to launch silently in the background when you sign in.";
                                    }
                                }
                            }

                            // Launch on Startup Toggle Row
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.space-4;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Launch on System Startup";
                                        font-size: Theme.type-body.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                    }
                                    Text {
                                        text: "Automatically start Sotto in the system tray when signing in";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 46px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: root.launch-on-startup ? Theme.accent : Theme.line;
                                        animate background { duration: 150ms; }

                                        Rectangle {
                                            x: root.launch-on-startup ? 23px : 3px;
                                            y: 3px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.white;
                                            animate x { duration: 150ms; easing: ease-out; }
                                        }

                                        startup_touch := TouchArea {
                                            clicked => {
                                                root.toggle-launch-on-startup();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // =================================================================
                    // BOX 5: FEEDBACK & MEDIA CARD
                    // =================================================================
                    feedback_card := Rectangle {
                        background: Theme.card-bg;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.line;

                        // Specular Top Sheen
                        Rectangle {
                            y: 1px; x: 12px; width: parent.width - 24px; height: 1px;
                            background: Theme.white; opacity: 0.08;
                        }

                        VerticalLayout {
                            padding: Theme.space-24;
                            spacing: Theme.space-16;

                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: Theme.space-4;
                                    Text {
                                        text: "FEEDBACK & MEDIA CONTROL";
                                        font-size: Theme.type-label.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                        font-family: Theme.font-mono;
                                        letter-spacing: 0.5px;
                                    }
                                    Text {
                                        text: "Quiet audio feedback cues and intelligent background media pause";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    InfoTooltip {
                                        align-right: true;
                                        tip: "Uses OS media controls to pause active media (Spotify, YouTube, VLC) during dictation and resumes 140ms after text is typed. Active calls (Zoom, Teams, Slack) are never paused.";
                                    }
                                }
                            }

                            // Start / stop chimes
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.space-4;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Start & Stop Chimes";
                                        font-size: Theme.type-body.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                    }
                                    Text {
                                        text: "Soft harmonic rising fifth (G4 → C5) on start, falling when stopped";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 46px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: root.chimes-enabled ? Theme.accent : Theme.line;
                                        animate background { duration: 150ms; }

                                        Rectangle {
                                            x: root.chimes-enabled ? 23px : 3px;
                                            y: 3px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.white;
                                            animate x { duration: 150ms; easing: ease-out; }
                                        }

                                        chimes_touch := TouchArea {
                                            clicked => {
                                                root.toggle-chimes();
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            // Media pause / resume
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.space-4;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: "Pause Media While Dictating";
                                        font-size: Theme.type-body.size;
                                        font-weight: 600;
                                        color: Theme.ink-primary;
                                    }
                                    Text {
                                        text: "Pauses non-call playback for the take and resumes after text is injected";
                                        font-size: Theme.type-label.size;
                                        font-weight: Theme.type-label.weight;
                                        color: Theme.ink-secondary;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 46px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: root.media-pause-enabled ? Theme.accent : Theme.line;
                                        animate background { duration: 150ms; }

                                        Rectangle {
                                            x: root.media-pause-enabled ? 23px : 3px;
                                            y: 3px;
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.white;
                                            animate x { duration: 150ms; easing: ease-out; }
                                        }

                                        media_pause_touch := TouchArea {
                                            clicked => {
                                                root.toggle-media-pause();
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Media control is conservative: calls and unknown apps are left alone; only the paused session resumes.";
                                font-size: Theme.type-caption.size;
                                font-weight: Theme.type-caption.weight;
                                color: Theme.ink-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Top Vignette Edge Shadow
            Rectangle {
                y: 0px;
                x: 0px;
                width: parent.width;
                height: 18px;
                background: @linear-gradient(180deg, Theme.vignette 0%, transparent 100%);
                opacity: (root.custom-scroll-progress > 0.01) ? 1.0 : 0.0;
                animate opacity { duration: 180ms; easing: ease-out; }
            }

            // Bottom Vignette Edge Shadow
            Rectangle {
                y: parent.height - 18px;
                x: 0px;
                width: parent.width;
                height: 18px;
                background: @linear-gradient(0deg, Theme.vignette 0%, transparent 100%);
                opacity: (root.custom-can-scroll && root.custom-scroll-progress < 0.99) ? 1.0 : 0.0;
                animate opacity { duration: 180ms; easing: ease-out; }
            }

            // Modern Glass Scrollbar Indicator (Syncs with Lenis Physics + Drag - Tab 0 Parity)
            if (root.custom-can-scroll) : Rectangle {
                x: parent.width - 6px;
                y: 4px;
                width: 4px;
                height: parent.height - 8px;
                background: transparent;

                // Thumb
                thumb := Rectangle {
                    width: 4px;
                    height: Math.max(28px, (parent.height) * (parent.height / Math.max(1px, root.custom-content-height)));
                    y: root.custom-scroll-progress * (parent.height - self.height);
                    border-radius: Theme.radius-pill;
                    background: root.custom-is-scrolling ? Theme.ink-muted : Theme.line-strong;
                    opacity: root.custom-is-scrolling ? 0.9 : 0.4;
                    animate opacity { duration: 200ms; }
                    animate background { duration: 200ms; }
                }

                TouchArea {
                    width: 24px;
                    x: -10px;
                    height: parent.height;

                    moved => {
                        if (self.pressed) {
                            let thumb-h = thumb.height;
                            let avail = parent.height - thumb-h;
                            let norm_y = avail > 0px ? Math.min(1.0, Math.max(0.0, (self.mouse-y - thumb-h * 0.5) / avail)) : 0.0;
                            root.custom-drag-scroll(norm_y);
                        }
                    }
                    clicked => {
                        let thumb-h = thumb.height;
                        let avail = parent.height - thumb-h;
                        let norm_y = avail > 0px ? Math.min(1.0, Math.max(0.0, (self.mouse-y - thumb-h * 0.5) / avail)) : 0.0;
                        root.custom-drag-scroll(norm_y);
                    }
                }
            }
        }
        }
    }
}
